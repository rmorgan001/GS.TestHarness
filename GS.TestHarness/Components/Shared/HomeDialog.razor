@* Asks the user to put the mount in the home position before a run that moves it. *@
<h2 class="dialog-title" style="display: flex; align-items: center; gap: .6rem; color: var(--fail);">
    <Icon Kind="AlertCircle" Size="44" />
    <span>Safety Warning: Put the mount in the home position!</span>
</h2>

<div class="dialog-message with-icon">
    <Icon Kind="Telescope" Size="28" />
    <span>
        @if (Model.Status.Error is { } error)
        {
            @error<br /><br />
        }
        Click the "Go home" button below - OR - manually put the mount in the home position, then power the mount <b>OFF</b> and <b>ON</b> again, then click Check again.<br /><br />
        Finally: Click "Start run" when the mount is in the home position.
    </span>
</div>

@if (Model.Note is { } note)
{
    <p class="muted">@note</p>
}

<div class="dialog-buttons">
    <button type="button" class="btn primary" disabled="@Model.Busy" @onclick="() => Model.Close(true)">Start run</button>
    <button type="button" class="btn" disabled="@(Model.Busy || (!Model.Status.CanFindHome && Model.Status.Error is null))" @onclick="() => Model.GoHomeAsync(Changed)">Go home</button>
    <button type="button" class="btn" disabled="@Model.Busy" @onclick="() => Model.CheckAsync(Changed)">Check again</button>
    <button type="button" class="btn" @onclick="() => Model.Close(false)">Cancel</button>
</div>

@code {
    [Parameter, EditorRequired] public HomeDialogModel Model { get; set; } = default!;

    private void Changed() => _ = InvokeAsync(StateHasChanged);
}
