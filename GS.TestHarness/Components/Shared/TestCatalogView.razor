@* Every check the harness makes (Engine/TestCatalog.cs): what it is for, how it is tested, how the result is judged
   and what it is based on, searchable and by group. Shown in the help's "The tests" section (it was the Tests tab).
   CatalogTests keeps the catalog in step with the checks. *@

<div class="summary catalog-toolbar">
    <input type="search" placeholder="Search tests" aria-label="Search tests" @bind="_search" @bind:event="oninput" />
    <div class="catalog-groups" role="group" aria-label="Groups">
        <button class="chip @(_group is null ? "on" : null)" @onclick="() => _group = null">All <span class="chip-count">@TestCatalog.Entries.Count</span></button>
        @foreach (var g in TestCatalog.Groups)
        {
            var count = TestCatalog.Entries.Count(e => TestCatalog.DisplayGroup(e) == g.Name);
            <button class="chip @(_group == g.Name ? "on" : null)" @onclick="() => _group = g.Name">@g.Name <span class="chip-count">@count</span></button>
        }
    </div>
</div>
@{ var shown = 0; }
@foreach (var g in TestCatalog.Groups.Where(g => _group is null || g.Name == _group))
{
    var entries = TestCatalog.Entries.Where(e => TestCatalog.DisplayGroup(e) == g.Name && Matches(e)).ToList();
    if (entries.Count == 0) continue;
    shown += entries.Count;
    <section class="card catalog-group" id="tests-@g.Name">
        <h3>@g.Name <span class="muted catalog-when">Runs: @g.RunsWhen</span></h3>
        <p class="muted">@g.Summary</p>
        <div class="table-scroll">
            <table class="results catalog">
                <thead>
                    <tr><th>No.</th><th>Test</th><th>Tier</th><th>Objective</th><th>How it's tested</th><th>How it's verified</th><th>References</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in entries)
                    {
                        <tr id="test-@e.Number">
                            <td class="mono catalog-no">@e.Number</td>
                            <td class="mono catalog-id">@e.DisplayId</td>
                            <td>
                                @e.Tier
                                @if (e.FollowsUp.Count > 0)
                                {
                                    <div class="small muted">follows up tier @(e.Tier - 1):</div>
                                    @foreach (var key in e.FollowsUp)
                                    {
                                        <div class="mono small"><a href="help#test-@TestNumbers.For(key)">@TestNumbers.For(key)</a> @key</div>
                                    }
                                }
                            </td>
                            <td>@e.Objective</td>
                            <td>@e.Method</td>
                            <td>@e.Verification</td>
                            <td class="catalog-refs">
                                @foreach (var key in e.Refs)
                                {
                                    var r = TestCatalog.Reference(key);
                                    @if (r.Url is { } url)
                                    {
                                        <a href="@url" target="_blank" rel="noopener" title="@r.Title">@key</a>
                                    }
                                    else
                                    {
                                        <span title="@r.Title">@key</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
@if (shown == 0)
{
    <p class="muted">No test matches “@_search”.</p>
}

<section class="card catalog-group" id="tests-references">
    <h3>Reference material</h3>
    <dl class="catalog-ref-list">
        @foreach (var r in TestCatalog.References)
        {
            <dt class="mono">@r.Key</dt>
            <dd>
                @if (r.Url is { } url)
                {
                    <a href="@url" target="_blank" rel="noopener">@r.Title</a>
                }
                else
                {
                    @r.Title
                }
            </dd>
        }
    </dl>
</section>

@code {
    private string _search = "";
    private string? _group;

    private bool Matches(CatalogEntry e)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var s = _search.Trim();
        return new[] { e.Number.ToString(), e.Id, $"tier {e.Tier}", e.Objective, e.Method, e.Verification, string.Join(" ", e.Refs), string.Join(" ", e.FollowsUp), string.Join(" ", e.FollowsUp.Select(TestNumbers.For)) }
            .Any(text => text.Contains(s, StringComparison.OrdinalIgnoreCase));
    }
}
