@* The findings of a run: counts that filter by outcome, a group filter and search, and a row per finding
   that opens to show the expected and actual values, the fix and where the code is. *@

<div class="summary">
    @foreach (var outcome in Order)
    {
        var count = Results.Count(r => r.Outcome == outcome);
        <button class="chip @Css(outcome) @(_outcomes.Contains(outcome) ? "on" : "")" @onclick="() => Toggle(outcome)"
                title="Show @outcome (click again to hide it; with none picked, all show)">
            <span class="chip-count">@count</span> @Label(outcome)
        </button>
    }
    <span class="spacer"></span>
    <select @bind="_group" aria-label="Group">
        <option value="">All groups</option>
        @foreach (var g in Results.Select(r => r.Group).Distinct())
        {
            <option value="@g">@g</option>
        }
    </select>
    <input type="search" placeholder="Search" @bind="_search" @bind:event="oninput" aria-label="Search findings" />
</div>

@if (Shown.Count == 0)
{
    <p class="muted empty">@(Results.Count == 0 ? Empty : "No findings match the filter.")</p>
}
else
{
    <table class="results findings">
        <thead>
            <tr><th class="col-outcome">Result</th><th class="col-no">No.</th><th class="col-member">Member</th><th>Finding</th><th class="col-ms">ms</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Shown)
            {
                var open = _open.Contains(r);
                <tr class="row @Css(r.Outcome) @(open ? "open" : "")" @onclick="() => ToggleOpen(r)">
                    <td><span class="badge @Css(r.Outcome)">@Label(r.Outcome)</span></td>
                    <td class="mono num" title="Test @r.Number (tier @TestNumbers.TierOf(r.Number))">@r.Number</td>
                    <td class="mono">@r.Member</td>
                    <td>@r.Message @if (r.Fix is not null && !open) { <span class="hint">· how to fix</span> }</td>
                    <td class="num">@(r.DurationMs > 0 ? r.DurationMs.ToString("0") : "")</td>
                </tr>
                @if (open)
                {
                    <tr class="detail">
                        <td colspan="5">
                            <dl>
                                <dt>Check</dt><dd class="mono"><a href="help#test-@r.Number" @onclick:stopPropagation="true">@r.Number</a> @r.Id</dd>
                                @if (r.Expected is not null) { <dt>Expected</dt><dd>@r.Expected</dd> }
                                @if (r.Actual is not null) { <dt>Actual</dt><dd class="pre">@r.Actual</dd> }
                                @if (r.Fix is not null) { <dt>How to fix</dt><dd class="fix">@r.Fix <button type="button" class="link" title="Copy the fix text to the clipboard" @onclick="() => CopyAsync(r)" @onclick:stopPropagation="true">@(_copied == r.Id ? "Copied" : "Copy")</button></dd> }
                                @if (r.Source is not null) { <dt>Code to check</dt><dd class="mono">@r.Source</dd> }
                                @if (r.Reference is not null) { <dt>Reference</dt><dd><a href="@r.Reference" target="_blank" rel="noopener">@r.Reference</a></dd> }
                            </dl>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string? _copied;

    /// <summary>Puts the finding's fix, with its check and message, on the clipboard (to paste into a ticket or a message).</summary>
    private async Task CopyAsync(CheckResult r)
    {
        var text = $"{r.Id}: {r.Message}" + (r.Expected is null ? "" : $"\nExpected: {r.Expected}") + (r.Actual is null ? "" : $"\nActual: {r.Actual}")
                   + $"\nHow to fix: {r.Fix}" + (r.Source is null ? "" : $"\nCode to check: {r.Source}");
        try
        {
            if (await JS.InvokeAsync<bool>("gsCopy", text)) _copied = r.Id;
        }
        catch (Exception) { /* no clipboard here */ }
    }

    [Parameter, EditorRequired] public IReadOnlyList<CheckResult> Results { get; set; } = [];
    [Parameter] public string Empty { get; set; } = "No findings yet.";

    public static readonly Outcome[] Order = [Outcome.Fail, Outcome.Error, Outcome.Warning, Outcome.Pass, Outcome.Info, Outcome.Skipped];

    private readonly HashSet<Outcome> _outcomes = [];
    private readonly HashSet<CheckResult> _open = [];
    private string _group = "";
    private string _search = "";

    private List<CheckResult> Shown => [.. Results.Where(r =>
        (_outcomes.Count == 0 || _outcomes.Contains(r.Outcome))
        && (_group.Length == 0 || r.Group == _group)
        && (_search.Length == 0 || r.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Number.ToString() == _search.Trim()
            || r.Message.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Member.Contains(_search, StringComparison.OrdinalIgnoreCase)))];

    private void Toggle(Outcome o)
    {
        if (!_outcomes.Remove(o)) _outcomes.Add(o);
    }

    private void ToggleOpen(CheckResult r)
    {
        if (!_open.Remove(r)) _open.Add(r);
    }

    public static string Css(Outcome o) => o.ToString().ToLowerInvariant();

    public static string Label(Outcome o) => o switch
    {
        Outcome.Fail => "Fail",
        Outcome.Error => "Error",
        Outcome.Warning => "Warning",
        Outcome.Pass => "Pass",
        Outcome.Info => "Info",
        _ => "Skipped"
    };
}
