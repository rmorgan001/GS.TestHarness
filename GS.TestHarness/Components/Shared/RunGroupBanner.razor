@inject RunPageState State

@* On Reviews and Summary: which reports they are showing. By default the newest run of each device; when a run group is picked on the
   Reports tab, that group, with a way back. *@
@if (Group is { } g)
{
    <div class="run-group-banner" role="status">
        <span><b>Showing run group</b>
            <a href="reports/@g.Root.Id">@g.Root.Reference</a>:
            @foreach (var run in g.Runs)
            {
                <span class="tier-badge tier-@run.Options.Tier">Tier @run.Options.Tier</span><a href="reports/@run.Id" class="mono"> @run.Reference </a>
            }
            <span class="muted">· @g.Root.Label · @g.Root.Started.ToString("yyyy-MM-dd HH:mm")</span></span>
        <button type="button" class="btn" title="Go back to the newest run of each device" @onclick="() => State.GroupId = null">Latest runs</button>
    </div>
}

@code {
    /// <summary>The run group being shown, or null for the default (the newest run of each device).</summary>
    [Parameter] public RunGroup? Group { get; set; }
}
