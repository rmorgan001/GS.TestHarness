@* The ASCOM telescope drivers registered on this computer; the one picked is added as a COM server. *@
<h2 class="dialog-title">ASCOM Drivers</h2>

<div class="dialog-message with-icon">
    <Icon Kind="Telescope" Size="28" />
    <span>@Model.Message</span>
</div>

@if (Model.Drivers.Count > 0)
{
    <ul class="found-list">
        @foreach (var driver in Model.Drivers)
        {
            <li>
                <label class="check">
                    <input type="radio" name="ascom-driver" checked="@(driver.ProgId == Model.SelectedProgId)"
                           @onchange="() => Model.SelectedProgId = driver.ProgId" />
                    <span><b>@driver.Name</b> <span class="muted mono">@driver.ProgId</span></span>
                </label>
            </li>
        }
    </ul>
}

<div class="dialog-buttons">
    <button type="button" class="btn primary" disabled="@(Model.SelectedProgId is null)" @onclick="() => Model.Close(true)">Add</button>
    <button type="button" class="btn" @onclick="() => Model.Close(false)">Cancel</button>
</div>

@code {
    [Parameter, EditorRequired] public ComDriversDialogModel Model { get; set; } = default!;

    protected override Task OnInitializedAsync() => Model.LoadAsync();
}
