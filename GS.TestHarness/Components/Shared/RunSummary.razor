@* Above the findings: the button to run the last run (or its problem groups) again. There used to be a summary with it, a headline
   counting the problems, the first few listed and what had changed since the last run; the list of findings below has it all. *@
@if (Results.Any(r => r.IsProblem) && !Running && Rerun.HasDelegate && CanRerun)
{
    <div class="run-summary-actions">
        <button type="button" class="btn" title="@RerunTitle" disabled="@RerunBusy" @onclick="Rerun">
            <Icon Kind="Play" Size="16" /> @(RerunBusy ? "Checking the mount…" : RerunText)
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CheckResult> Results { get; set; } = [];

    /// <summary>The run is still going: no button until it has finished.</summary>
    [Parameter] public bool Running { get; set; }

    /// <summary>Run it again; the button shows when this is set.</summary>
    [Parameter] public EventCallback Rerun { get; set; }

    /// <summary>Whether there is something to run again (the page knows: it depends on the run's tier).</summary>
    [Parameter] public bool CanRerun { get; set; }

    /// <summary>What the button says.</summary>
    [Parameter] public string RerunText { get; set; } = "Re-run the groups with problems";

    /// <summary>The re-run is getting ready (connecting to the mount): the button says so.</summary>
    [Parameter] public bool RerunBusy { get; set; }

    /// <summary>What the button's tooltip says.</summary>
    [Parameter] public string RerunTitle { get; set; } = "Run it again to check a fix, without waiting for the whole run";
}
