@* A plain-language summary above the findings: how many things need a look, and the ones to look at first
   (failures, then errors, then warnings; anything about the mount's safety ahead of the rest), what changed since the
   last run of the same device, and a button to run just the problems again. *@
@if (Results.Count > 0)
{
    var fail = Results.Count(r => r.Outcome == Outcome.Fail);
    var error = Results.Count(r => r.Outcome == Outcome.Error);
    var warning = Results.Count(r => r.Outcome == Outcome.Warning);
    var problems = fail + error + warning;
    <div class="run-summary @(problems == 0 ? "ok" : fail + error > 0 ? "bad" : "warn")" role="status">
        @if (problems == 0)
        {
            <b>No problems found@(Running ? " so far" : "").</b>
        }
        else
        {
            <b>@problems thing@(problems == 1 ? "" : "s") to look at@(Running ? " so far" : ""):</b>
            <span>@Parts(fail, error, warning)</span>
            <div class="run-summary-first">Look at these first:</div>
            <ol>
                @foreach (var r in First)
                {
                    <li><span class="badge @ResultsTable.Css(r.Outcome)">@ResultsTable.Label(r.Outcome)</span>
                        <span class="mono small">@TestNumbers.Label(r.Id)</span> @r.Message</li>
                }
            </ol>
            @if (problems > First.Count)
            {
                <div class="muted small">…and @(problems - First.Count) more in the list below.</div>
            }
        }

        @if (Changes is { IsEmpty: false } changes)
        {
            <div class="run-summary-first">Since @(PreviousLabel ?? "the last run"):
                <span class="@(changes.New.Count > 0 ? "changes-new" : null)">@changes.New.Count new</span>,
                <span class="@(changes.Fixed.Count > 0 ? "changes-fixed" : null)">@changes.Fixed.Count fixed</span>,
                @changes.Unchanged unchanged.</div>
            @if (changes.New.Count > 0)
            {
                <div class="small"><b>New:</b> @string.Join(", ", changes.New.Take(Shown).Select(r => TestNumbers.Label(r.Id)))@(changes.New.Count > Shown ? $" and {changes.New.Count - Shown} more" : "")</div>
            }
            @if (changes.Fixed.Count > 0)
            {
                <div class="small"><b>Fixed:</b> @string.Join(", ", changes.Fixed.Take(Shown).Select(r => TestNumbers.Label(r.Id)))@(changes.Fixed.Count > Shown ? $" and {changes.Fixed.Count - Shown} more" : "")</div>
            }
        }

        @if (problems > 0 && !Running && Rerun.HasDelegate && RerunPlan.For(new RunOptions(), Results) is not null)
        {
            <div class="run-summary-actions">
                <button type="button" class="btn" title="Run again only the groups that had problems, to check a fix without waiting for the whole run" @onclick="Rerun">
                    <Icon Kind="Play" Size="16" /> Re-run the groups with problems
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CheckResult> Results { get; set; } = [];

    /// <summary>The run is still going, so more may turn up.</summary>
    [Parameter] public bool Running { get; set; }

    /// <summary>The findings of the last run of the same device, to say what is new and what is fixed.</summary>
    [Parameter] public IReadOnlyList<CheckResult>? Previous { get; set; }

    /// <summary>What to call that run ("RAC0012", "the run on 3 May").</summary>
    [Parameter] public string? PreviousLabel { get; set; }

    /// <summary>Run only the problems again; the button shows when this is set.</summary>
    [Parameter] public EventCallback Rerun { get; set; }

    private const int Shown = 5;

    private RunComparison? Changes => Previous is null || Running ? null : RunComparison.Compare(Results, Previous);

    private static string Parts(int fail, int error, int warning)
    {
        var parts = new List<string>();
        if (fail > 0) parts.Add($"{fail} failure{(fail == 1 ? "" : "s")}");
        if (error > 0) parts.Add($"{error} error{(error == 1 ? "" : "s")} (the check couldn't be made)");
        if (warning > 0) parts.Add($"{warning} warning{(warning == 1 ? "" : "s")}");
        return string.Join(", ", parts);
    }

    private IReadOnlyList<CheckResult> First => [.. Results
        .Where(r => r.Outcome is Outcome.Fail or Outcome.Error or Outcome.Warning)
        .OrderByDescending(Safety)
        .ThenBy(r => r.Outcome switch { Outcome.Fail => 0, Outcome.Error => 1, _ => 2 })
        .Take(Shown)];

    /// <summary>Findings about the mount's safety come first: the pre-motion gate, where the mount starts, its site and position.</summary>
    private static bool Safety(CheckResult r)
        => r.Id.EndsWith(".Gate", StringComparison.Ordinal) || r.Id is "Motion.StartPosition" or "Properties.SiteHemisphere" or "ParkHome.HomePole"
           || r.Id.StartsWith("Properties.AltAz", StringComparison.Ordinal)
           || r.Member is "SiteLatitude" or "SiteLongitude" or "SiderealTime" or "AtPark" or "AtHome";
}
