@* Your own colours, in a dialog: the same editor as under Options. The page is not dimmed, so the change shows as you make it. *@
<h2 class="dialog-title">Your own colours <HelpLink Anchor="themes" /></h2>

<ThemeEditor InDialog="true" />

<div class="dialog-buttons" style="justify-content: center;">
    <button type="button" class="btn primary" autofocus @onclick="() => Model.Close(true)">Done</button>
</div>

@code {
    [Parameter, EditorRequired] public ThemeDialogModel Model { get; set; } = default!;
}
