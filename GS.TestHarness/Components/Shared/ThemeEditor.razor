@inject IJSRuntime JS
@inject ThemeService Theme

@* Your own colour theme: seven colours, with a live preview. The rest of the palette (panels, lines, hover shades) is worked
   out from them. Kept by this browser; Export and Import move it between browsers and projects. *@
<section class="card theme-editor">
    <h2>Your own colours <HelpLink Anchor="themes" /></h2>
    <p class="muted small">Change a colour and the page changes with it. Panels, lines and hover shades are worked out from these seven.
        Kept by this browser; use Export to take the palette elsewhere.</p>

    <div class="theme-actions">
        <label>Start from
            <select @bind="_base">
                <option value="dark">Dark</option>
                <option value="day">Day</option>
                <option value="dusk">Dusk</option>
                <option value="night">Night</option>
            </select>
        </label>
        <button type="button" class="btn" title="Replace these colours with that theme's" @onclick="UseBase">Use it</button>
    </div>

    @foreach (var (key, label, use) in ThemeColours.Keys)
    {
        var hex = _colours.GetValueOrDefault(key, "#000000");
        <div class="theme-row">
            <span title="@use">@label</span>
            <input type="color" value="@hex" aria-label="@label colour" @oninput="e => ChangeAsync(key, e.Value?.ToString())" />
            <span class="theme-hex">@hex</span>
            @if (key == "bg")
            {
                <span class="muted small">@use</span>
            }
            else
            {
                var ratio = ThemeColours.Contrast(hex, _colours.GetValueOrDefault("bg"));
                <span class="@(ratio >= 4.5 ? "ratio-ok" : "ratio-low") small">
                    @(ratio >= 4.5 ? "✓" : "⚠") @ratio.ToString("0.0")<text>:1 against the background</text>@(ratio >= 4.5 ? "" : ", hard to read")
                </span>
            }
        </div>
    }

    <p class="small @(_safe ? "ratio-ok" : "muted")">
        @(_safe ? "✓ Red-light safe: these colours have almost no green or blue, so they keep your night vision."
                : "Not red-light safe: the colours include green or blue light. For the telescope, keep every colour a deep red.")
    </p>

    <div class="theme-actions">
        <button type="button" class="btn" @onclick="ExportAsync">Export</button>
        <button type="button" class="btn" @onclick="() => _showImport = !_showImport">Import…</button>
        @if (_message is not null) { <span class="small @(_messageIsError ? "ratio-low" : "ratio-ok")">@_message</span> }
    </div>
    @if (_exported is not null)
    {
        <textarea readonly aria-label="Exported palette" onfocus="this.select()">@_exported</textarea>
    }
    @if (_showImport)
    {
        <textarea placeholder="Paste a palette here" aria-label="Palette to import" @bind="_import" @bind:event="oninput"></textarea>
        <div class="theme-actions"><button type="button" class="btn primary" @onclick="ImportAsync">Use this palette</button></div>
    }
</section>

@code {
    private Dictionary<string, string> _colours = new(ThemeColours.Presets["dark"]);
    private string _base = "dark", _import = "";
    private string? _exported, _message;
    private bool _showImport, _messageIsError;

    private bool _safe => ThemeColours.RedLightSafe(_colours);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (await JS.InvokeAsync<Dictionary<string, string>?>("gsTheme.getCustom") is { } stored)
            {
                _colours = stored;
                StateHasChanged();
            }
        }
        catch (Exception) { /* no browser to ask */ }
    }

    /// <summary>Keeps the colours, and switches to the custom theme so the change shows.</summary>
    private async Task SaveAsync()
    {
        _message = null;
        _exported = null;
        try
        {
            await JS.InvokeVoidAsync("gsTheme.setCustom", _colours);
            if (Theme.Current != "custom")
            {
                await JS.InvokeVoidAsync("gsTheme.set", "custom");
                Theme.Set("custom");
            }
        }
        catch (Exception) { /* no browser to ask */ }
    }

    private async Task ChangeAsync(string key, string? value)
    {
        if (ThemeColours.Parse(value) is null) return;
        _colours = new Dictionary<string, string>(_colours) { [key] = value!.ToLowerInvariant() };
        await SaveAsync();
    }

    private async Task UseBase()
    {
        _colours = new Dictionary<string, string>(ThemeColours.Presets[_base]);
        await SaveAsync();
    }

    private async Task ExportAsync()
    {
        _exported = ThemeColours.Export(_colours);
        try
        {
            var copied = await JS.InvokeAsync<bool>("gsCopy", _exported);
            (_message, _messageIsError) = (copied ? "Copied to the clipboard." : "Select the text below and copy it.", false);
        }
        catch (Exception) { (_message, _messageIsError) = ("Select the text below and copy it.", false); }
    }

    private async Task ImportAsync()
    {
        if (!ThemeColours.TryImport(_import, out var colours, out var error))
        {
            (_message, _messageIsError) = (error, true);
            return;
        }
        _colours = colours;
        _import = "";
        _showImport = false;
        await SaveAsync();
        (_message, _messageIsError) = ("Palette in use.", false);
    }

}
