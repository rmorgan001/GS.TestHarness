@* A small (?) beside a setting that opens its part of the help in the help window (as the header's help button does). *@
<a class="help-link" href="help#@Anchor" target="gs-testharness-help" data-popup="width=1000,height=800"
   title="@Title" aria-label="@Title"><Icon Kind="HelpCircle" Size="15" /></a>

@code {
    /// <summary>The id of the help section (help#anchor).</summary>
    [Parameter, EditorRequired] public string Anchor { get; set; } = "";

    [Parameter] public string Title { get; set; } = "What is this? Opens the help";
}
