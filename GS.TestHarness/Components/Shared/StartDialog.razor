@* The warning before a run: the user takes responsibility for watching the mount. When the mount isn't at the
   home position it also asks for it to be put there (Go home, or by hand and Check again). *@
<h2 class="dialog-title" style="display: flex; align-items: center; gap: .6rem;">
    <Icon Kind="Alert" Size="52" />
    <span>@Model.Title</span>
</h2>

@if (Model.IsAtHome)
{
    <p class="dialog-message" style="font-weight: 600; font-size: 1.1rem; color: var(--yellow);">Please verify the mount is in the home position</p>
}

@if (Model.HasError)
{
    <div class="dialog-message with-icon" style="align-items: center; gap: 1.2rem;">
        <span style="flex-shrink: 0; display: flex; color: var(--fail);"><Icon Kind="Telescope" Size="72" /></span>
        <span style="white-space: normal;">
            <b style="color: var(--fail); font-size: 1.15rem;">@(Model.NotConnected ? "The mount is not connected" : "The mount's position couldn't be read")</b><br /><br />
            <span style="color: var(--fail);">@Model.Status?.Error</span><br /><br />
            The run can't start until the mount is connected and reports where it is. If you've just powered it off and on, give it a moment, then click Check again. Otherwise click Cancel, check the mount and its connection, and start again.
        </span>
    </div>
}
else
{
    @if (Model.NeedsHome)
    {
        <div class="dialog-message with-icon" style="align-items: center; gap: 1.2rem;">
            <span style="flex-shrink: 0; display: flex; color: var(--fail);"><Icon Kind="Telescope" Size="72" /></span>
            <span style="white-space: normal;">
                <b style="color: var(--fail); font-size: 1.15rem;">Put the mount in the home position</b><br /><br />
                <span style="color: var(--yellow);">Finally: Click "Start run" when the mount is in the home position</span><br /><br />
                Click the "Go home" button below - OR - manually put the mount in the home position, then power the mount <b>OFF</b> and <b>ON</b> again, then click Check again.
            </span>
        </div>
    }

    @* Each bullet stands out in its own highlighted box. *@
    <div style="margin: 0 0 1rem;">
        @foreach (var line in Model.Message.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            <div style="margin-bottom: .5rem; padding: .55rem .8rem; border-left: 4px solid var(--yellow); border-radius: 4px; background: color-mix(in srgb, var(--yellow) 12%, transparent); font-weight: 600;">@line</div>
        }
    </div>

    @* Settings that look wrong for this run, each in its own red box. *@
    @if (Model.Warnings.Count > 0)
    {
        <div style="margin: 0 0 1rem;">
            @foreach (var warning in Model.Warnings)
            {
                <div style="margin-bottom: .5rem; padding: .55rem .8rem; border-left: 4px solid var(--fail); border-radius: 4px; background: color-mix(in srgb, var(--red) 12%, transparent);">@warning</div>
            }
        </div>
    }

    <p class="dialog-message" style="color: var(--yellow);">By clicking Start you accept responsibility for monitoring the mount's safety.</p>
}

@if (Model.Note is { } note)
{
    <p class="dialog-message" style="color: @(Model.NoteIsProblem ? "var(--fail)" : "var(--green)"); text-align: center; margin-bottom: 0;">@note</p>
}

<div class="dialog-buttons" style="justify-content: center; align-items: flex-start;">
    @if (!Model.HasError)
    {
        <div class="dialog-choice">
            <button type="button" class="btn danger-btn" disabled="@(Model.Busy || Model.NeedsHome)" @onclick="() => Model.Close(true)">Start run</button>
            <small>@(Model.NeedsHome ? "Available once the mount is at home." : "Begins the run. You are responsible for watching the mount.")</small>
        </div>
        @if (Model.HasMount)
        {
            <div class="dialog-choice">
                <button type="button" class="btn" disabled="@(Model.Busy || (Model.Status is { CanFindHome: false }))" @onclick="() => Model.GoHomeAsync(Changed)">Go home</button>
                <small>Slews the mount to the home position.</small>
            </div>
        }
    }
    @if (Model.HasMount)
    {
        @* Also after an error: a mount that is still starting up after a power cycle can be tried again without closing the dialog. *@
        <div class="dialog-choice">
            <button type="button" class="btn" disabled="@Model.Busy" @onclick="() => Model.CheckAsync(Changed)">Check again</button>
            <small>Reads the position again, after you have moved the mount or powered it off and on.</small>
        </div>
    }
    @* A dangerous choice doesn't get the focus: Enter alone mustn't accept it. *@
    <div class="dialog-choice">
        <button type="button" class="btn" autofocus disabled="@Model.Busy" @onclick="() => Model.Close(false)">Cancel</button>
        <small>@(Model.HasMount ? "Closes this and disconnects the mount." : "Closes this without starting.")</small>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StartDialogModel Model { get; set; } = default!;

    private void Changed() => _ = InvokeAsync(StateHasChanged);
}
