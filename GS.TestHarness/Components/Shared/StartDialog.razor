@* The warning before a run, in the order a person acts on it: where the mount is (for a run that moves it), then what to
   check before starting, then the responsibility line and the buttons. Start run is only offered once the mount is at home. *@
<div class="safety-dialog">
    <h2 class="safety-title">
        <Icon Kind="Alert" Size="40" />
        <span>@Model.Title</span>
    </h2>
    <p class="safety-lead">@(Model.HasMount ? "This run moves the mount by itself. Go through these points, then start." : "Go through these points, then start the run.")</p>

    @{ var step = 0; }

    @if (Model.HasMount)
    {
        <section class="safety-section">
            <h3 class="safety-h">
                <span class="safety-num">@(++step)</span> Mount position
                @if (Model.HasError)
                {
                    <span class="safety-chip bad">@(Model.NotConnected ? "Not connected" : "Can't read position")</span>
                }
                else if (Model.IsAtHome)
                {
                    <span class="safety-chip ok">✓ At home</span>
                }
                else if (Model.NeedsHome)
                {
                    <span class="safety-chip bad">Not at home</span>
                }
            </h3>

            @if (Model.HasError)
            {
                <div class="safety-card bad">
                    <div class="safety-card-head">
                        <Icon Kind="Telescope" Size="34" />
                        <div>
                            <b>@(Model.NotConnected ? "The mount is not connected." : "The mount's position couldn't be read.")</b>
                            <div class="safety-error">@Model.Status?.Error</div>
                        </div>
                    </div>
                    <p class="safety-small">The run can't start until the mount is connected and reports where it is. If you've just powered it off and on, give it a
                        moment and check again. Otherwise cancel, check the mount and its connection, and start again.</p>
                    <button type="button" class="btn" disabled="@Model.Busy" @onclick="() => Model.CheckAsync(Changed)">Check for home</button>
                </div>
            }
            else if (Model.IsAtHome)
            {
                <div class="safety-card ok">
                    <div class="safety-card-head">
                        <Icon Kind="Telescope" Size="34" />
                        <div>
                            <b>The mount is at the home position.</b>
                            <div class="safety-small">Please check that this is true before you start.</div>
                        </div>
                    </div>
                    <button type="button" class="btn" disabled="@Model.Busy" @onclick="() => Model.CheckAsync(Changed)">Check for home</button>
                </div>
            }
            else
            {
                <div class="safety-card bad">
                    <div class="safety-card-head">
                        <Icon Kind="Telescope" Size="34" />
                        <div>
                            <b>The mount is not at the home position.</b>
                            <div class="safety-small">A run starts from the home position. Choose one:</div>
                        </div>
                    </div>
                    <div class="safety-options">
                        <div class="safety-option">
                            <b>A. Let the mount go home</b>
                            <span class="safety-small">It slews to the home position.</span>
                            <button type="button" class="btn" disabled="@(Model.Busy || Model.Status is { CanFindHome: false })" @onclick="() => Model.GoHomeAsync(Changed)">Go home</button>
                        </div>
                        <div class="safety-option">
                            <b>B. Do it by hand</b>
                            <span class="safety-small">Put the mount in the home position, power it <b>OFF</b> and <b>ON</b> again, then check.</span>
                            <button type="button" class="btn" disabled="@Model.Busy" @onclick="() => Model.CheckAsync(Changed)">Check for home</button>
                        </div>
                    </div>
                    <p class="safety-next">Then click <b>Start run</b> once the mount is at home.</p>
                </div>
            }

            @if (Model.Note is { } note)
            {
                <p class="safety-note @(Model.NoteIsProblem ? "problem" : null)" role="status">@note</p>
            }
        </section>
    }

    @if (!Model.HasError)
    {
        <section class="safety-section">
            <h3 class="safety-h"><span class="safety-num">@(++step)</span> Before you start</h3>
            <ul class="safety-list">
                @foreach (var line in Model.Message.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    <li>@line</li>
                }
            </ul>
            @if (Model.Warnings.Count > 0)
            {
                <div class="safety-sub">Check your settings</div>
                @foreach (var warning in Model.Warnings)
                {
                    <div class="safety-card warn"><span class="safety-small">@warning.TrimStart('⚠', ' ')</span></div>
                }
            }
        </section>

        <p class="safety-accept">By clicking <b>Start run</b> you accept responsibility for monitoring the mount's safety.</p>
    }

    <div class="safety-buttons">
        @if (!Model.HasError)
        {
            <div class="dialog-choice">
                <button type="button" class="btn danger-btn" disabled="@(Model.Busy || Model.NeedsHome)" @onclick="() => Model.Close(true)">Start run</button>
                <small>@(Model.NeedsHome ? "Available once the mount is at home." : "Begins the run.")</small>
            </div>
        }
        @* A dangerous choice doesn't get the focus: Enter alone mustn't accept it. *@
        <div class="dialog-choice">
            <button type="button" class="btn" autofocus disabled="@Model.Busy" @onclick="() => Model.Close(false)">Cancel</button>
            <small>@(Model.HasMount ? "Closes this and disconnects the mount." : "Closes this without starting.")</small>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StartDialogModel Model { get; set; } = default!;

    private void Changed() => _ = InvokeAsync(StateHasChanged);
}
