@implements IDisposable
@inject IJSRuntime JS
@inject ThemeService Theme
@inject DialogService Dialogs

@* Day / Dark / Dusk / Night / Custom: Dark is the default look; Dusk is dim amber and Night is red only, for dark-adapted eyes
   at the telescope; Custom is the user's own colours (a double click opens the editor). Remembered by this browser (wwwroot/theme.js, app.css). *@
<div class="theme-switch" role="group" aria-label="Colour theme">
    @foreach (var (name, label, title) in Themes)
    {
        <button type="button" aria-pressed="@(Theme.Current == name ? "true" : "false")" title="@title" @onclick="() => Pick(name)" @ondblclick="() => Edit(name)">@label</button>
    }
    @* The colour editor, without needing a double click. *@
    <button type="button" class="theme-edit" aria-label="Change your own colours" title="Change your own colours" @onclick="OpenEditor">✎</button>
</div>

@code {
    private static readonly (string Name, string Label, string Title)[] Themes =
    [
        ("day", "Day", "Light, for daylight"),
        ("dark", "Dark", "The default dark look"),
        ("dusk", "Dusk", "Dim amber, while your eyes adapt"),
        ("night", "Night", "Red only, to keep your night vision"),
        ("custom", "Custom", "Your own colours (double-click, or use the pencil, to change them)")
    ];

    protected override void OnInitialized() => Theme.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Theme.Set(await JS.InvokeAsync<string>("gsTheme.get"));
        }
        catch (Exception) { /* no browser to ask */ }
    }

    private async Task Pick(string name)
    {
        try
        {
            // The first time Custom is picked it starts as a copy of the dark theme, ready to change (double-click it).
            if (name == "custom" && await JS.InvokeAsync<Dictionary<string, string>?>("gsTheme.getCustom") is null)
                await JS.InvokeVoidAsync("gsTheme.setCustom", ThemeColours.Presets["dark"]);
            await JS.InvokeVoidAsync("gsTheme.set", name);
        }
        catch (Exception) { /* no browser to ask */ }
        Theme.Set(name);
    }

    /// <summary>A double click on Custom opens the colour editor in a dialog; the first click already switched to it.</summary>
    private async Task Edit(string name)
    {
        if (name != "custom") return;
        await OpenEditor();
    }

    /// <summary>The pencil: switches to Custom (starting from the dark theme if it has no colours yet) and opens the editor.</summary>
    private async Task OpenEditor()
    {
        await Pick("custom");
        await Dialogs.ShowAsync(new ThemeDialogModel());
    }

    public void Dispose() => Theme.Changed -= OnChanged;
}
