@inject IJSRuntime JS

@* Day / Dark / Dusk / Night: Dark is the default look; Dusk is dim amber and Night is red only, for dark-adapted eyes at the
   telescope. Remembered by this browser (wwwroot/app.js, app.css). *@
<div class="theme-switch" role="group" aria-label="Colour theme">
    @foreach (var (name, label, title) in Themes)
    {
        <button type="button" aria-pressed="@(_theme == name ? "true" : "false")" title="@title" @onclick="() => Pick(name)">@label</button>
    }
</div>

@code {
    private static readonly (string Name, string Label, string Title)[] Themes =
    [
        ("day", "Day", "Light, for daylight"),
        ("dark", "Dark", "The default dark look"),
        ("dusk", "Dusk", "Dim amber, while your eyes adapt"),
        ("night", "Night", "Red only, to keep your night vision")
    ];

    private string _theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _theme = await JS.InvokeAsync<string>("gsTheme.get");
            StateHasChanged();
        }
        catch (Exception) { /* no browser to ask */ }
    }

    private async Task Pick(string name)
    {
        _theme = name;
        try { await JS.InvokeVoidAsync("gsTheme.set", name); }
        catch (Exception) { /* no browser to ask */ }
    }
}
