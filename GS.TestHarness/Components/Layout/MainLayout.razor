@inherits LayoutComponentBase
@implements IDisposable
@inject RunPageState State
@inject NavigationManager Nav

@* As GS.Point3DWeb: a header across the top, the server list on the left, and the page on the right under its
   Conformance test / ConformU Debug Log Test / Options tabs. *@
<div class="shell">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>GS Test Harness</span>
            <span class="brand-version" title="Version @Version">v@(Version)</span>
            <span class="brand-sub">ASCOM compliance</span>
        </div>
        @* Opens the help (/help) in its own window (wwwroot/app.js); a plain new tab if pop-ups are blocked. *@
        <a class="help-button" href="help" target="gs-testharness-help" data-popup="width=1000,height=800"
           title="Open the help in a separate window" aria-label="Help">
            <Icon Kind="HelpCircle" Size="20" />
        </a>
    </header>

    <div class="workspace">
        <aside class="sidebar" id="sidebar">
            <ServerSidebar />
        </aside>
        <main class="main">
            @* ASCOM Conformance Check, ConformU Debug Log Test and Options across the top; each test's pages in a row
               under it (SubPages). The three tabs are panels of the Run page (/). *@
            @{ var top = ActiveTop; var pages = SubPages(top); }
            @* "solo": no pages row beneath, so the active tab opens into the page. *@
            <nav class="tabs @(pages.Length == 0 ? "solo" : null)" aria-label="Tests">
                @foreach (var (tab, label, icon) in TopTabs)
                {
                    <button type="button" class="tab @(top == tab ? "active" : null)" aria-current="@(top == tab ? "page" : null)"
                            @onclick="() => Show(tab)">
                        <Icon Kind="@icon" Size="18" /><span>@label</span>
                        @if (tab == RunPageTab.ConformU && State.Log is { Areas.Count: > 0 } log)
                        {
                            <span class="subtab-count" title="Problem areas in @log.FileName">@log.Areas.Count</span>
                        }
                    </button>
                }
            </nav>
            @if (pages.Length > 0)
            {
                <nav class="subnav" aria-label="@TopTabs.First(t => t.Tab == top).Label">
                    @foreach (var p in pages)
                    {
                        @if (p.Href.Length == 0)
                        {
                            @* Run opens this tab's panel of the Run page. *@
                            <NavLink class="subtab" href="" Match="NavLinkMatch.All" @onclick="() => State.Tab = top"><Icon Kind="@p.Icon" Size="16" /><span>@p.Label</span></NavLink>
                        }
                        else
                        {
                            <NavLink class="subtab" href="@p.Href"><Icon Kind="@p.Icon" Size="16" /><span>@p.Label</span></NavLink>
                        }
                    }
                </nav>
            }
            @* Only the page scrolls; the tabs stay put. *@
            <div class="page-scroll">
                <div class="page">
                    @Body
                </div>
            </div>
        </main>
    </div>
</div>

<DialogHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private static readonly string? Version = typeof(Program).Assembly.GetName().Version?.ToString(3);

    private static readonly (RunPageTab Tab, string Label, string Icon)[] TopTabs =
    [
        (RunPageTab.Conformance, "ASCOM Conformance Check", "ListChecks"),
        (RunPageTab.ConformU, "ConformU Debug Log Test", "FileDocument"),
        (RunPageTab.Options, "Options", "Pencil")
    ];

    private static readonly (string Href, string Label, string Icon) Run = ("", "Run", "Play"),
        Reports = ("reports", "Reports", "FileDocument"),
        Recommendations = ("recommendations", "Recommendations", "Lightbulb"),
        // The ConformU Debug Log Test's own lists, at their own addresses: they show only its runs.
        ConformUReports = (RunPageState.ConformUPrefix + "reports", "Reports", "FileDocument"),
        ConformURecommendations = (RunPageState.ConformUPrefix + "recommendations", "Recommendations", "Lightbulb");

    /// <summary>
    /// The pages under each top tab. Each test has its own Reports and Recommendations, which show only its runs: the
    /// ConformU Debug Log Test's are under conformu/. Options has none.
    /// </summary>
    private static (string Href, string Label, string Icon)[] SubPages(RunPageTab tab) => tab switch
    {
        RunPageTab.Conformance => [Run, Reports, Recommendations],
        RunPageTab.ConformU => [Run, ConformUReports, ConformURecommendations],
        _ => []
    };

    /// <summary>The page's address, base-relative, without query or fragment: "" for the Run page.</summary>
    private string PathNow => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    private bool OnRunPage => PathNow.Length == 0;

    /// <summary>A single report (reports/{id}): it belongs to the test that made it, which its page sets as the tab.</summary>
    private bool OnReportPage => PathNow.StartsWith("reports/", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The top tab the page open belongs to. The address says it for every page but the Run page (whose panel is the
    /// tab picked) and a single report (whose page set the tab from the report): conformu/... is the ConformU Debug Log
    /// Test's; anything else (Reports, Recommendations, Help) the conformance check's.
    /// </summary>
    private RunPageTab ActiveTop
        => OnRunPage ? State.Tab
            : RunPageState.IsConformUPage(PathNow) ? RunPageTab.ConformU
            : OnReportPage && State.Tab == RunPageTab.ConformU ? RunPageTab.ConformU
            : RunPageTab.Conformance;

    private void Show(RunPageTab tab)
    {
        // The page open, by its label: Reports (a single report counts as its list) or Recommendations.
        var label = OnReportPage ? "Reports"
            : SubPages(ActiveTop).FirstOrDefault(p => p.Href.Length > 0 && p.Href.Equals(PathNow, StringComparison.OrdinalIgnoreCase)).Label;
        State.Tab = tab;
        if (OnRunPage) return;
        // The same page under the other test (its Reports, its Recommendations); otherwise that test's Run page.
        var same = label is null ? null : SubPages(tab).FirstOrDefault(p => p.Href.Length > 0 && p.Label == label).Href;
        Nav.NavigateTo(same ?? "");
    }

    protected override void OnInitialized()
    {
        State.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Refresh();

    public void Dispose()
    {
        State.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
