@page "/reports"
@inject ReportStore Store

<PageTitle>Reports · GS Test Harness</PageTitle>

<header class="page-head">
    <h1>Reports</h1>
    <p class="muted">Every finished run, newest first. Saved in <span class="mono">@Store.Folder</span>.</p>
</header>

@if (_reports is null)
{
    <p class="muted">Loading…</p>
}
else if (_reports.Count == 0)
{
    <p class="muted">No runs yet. <a href="">Start one</a>.</p>
}
else
{
    <section class="card">
        <table class="results reports">
            <thead>
                <tr><th>When</th><th>Device</th><th>Version</th><th>Site</th><th>Via</th><th class="num">Fail</th><th class="num">Warn</th><th class="num">Pass</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in _reports)
                {
                    <tr>
                        <td class="mono">@r.Started.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a href="reports/@r.Id">@(r.Identity.Name ?? r.Target.Display)</a>@if (r.Cancelled) { <span class="badge skipped">stopped</span> }
                            @if (r.Options.AllowMotion) { <span class="badge info">motion</span> }</td>
                        <td class="mono">@r.Identity.DriverVersion</td>
                        <td>@r.SiteLabel</td>
                        <td>@(r.Target.Kind == TargetKind.Com ? "COM" : "Alpaca")</td>
                        <td class="num"><span class="count fail">@(r.Count(Outcome.Fail) + r.Count(Outcome.Error))</span></td>
                        <td class="num"><span class="count warning">@r.Count(Outcome.Warning)</span></td>
                        <td class="num">@r.Count(Outcome.Pass)</td>
                        <td class="actions">
                            <a href="download/@(r.Id).md" download>md</a>
                            <a href="download/@(r.Id).json" download>json</a>
                            <button class="link danger" @onclick="() => Delete(r)">delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private List<RunReport>? _reports;

    protected override async Task OnInitializedAsync() => _reports = await Store.ListAsync();

    private void Delete(RunReport r)
    {
        Store.Delete(r.Id);
        _reports?.Remove(r);
    }
}
