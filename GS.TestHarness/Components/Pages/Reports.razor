@page "/reports"
@page "/conformu/reports"
@implements IDisposable
@inject ReportStore Store
@inject DialogService Dialogs
@inject RunPageState State
@inject NavigationManager Nav

<PageTitle>Reports · GS Test Harness</PageTitle>

<header class="page-head">
    <h1>Reports</h1>
    <p class="muted">@(ConformUOnly ? "Every finished ConformU Debug Log Test run, newest first." : "Every finished ASCOM Conformance Check run, newest first.")
        Saved in <span class="mono">@Store.Folder</span>.</p>
</header>

@if (_reports is null)
{
    <p class="muted">Loading…</p>
}
else if (_reports.Count == 0)
{
    <div class="empty-state"><Icon Kind="FileDocument" Size="32" /><p>@(ConformUOnly ? "No ConformU runs yet." : "No ASCOM Conformance Check runs yet.")</p><a class="btn primary" href="">Start one</a></div>
}
else
{
    var groups = RunGroups.Build(_reports);
    var picked = RunGroups.Find(groups, State.GroupId);
    // The list shows the picked run group's reports, or every report when none is picked.
    var listed = Visible;
    var all = listed.Count > 0 && listed.All(r => _checked.Contains(r.Id));
    var prefix = ConformUOnly ? RunPageState.ConformUPrefix : "";
    @* Run groups: a tier 1 report with the deeper reports that followed it up. Picking one makes Reviews and Summary show it. *@
    <section class="card run-groups">
        <h2>Run groups</h2>
        <p class="muted small">A tier 1 report with the tier 2 and tier 3 reports that followed it up, and its re-runs. Pick a run group and the list below shows
            only its reports, and <b>Reviews</b> and <b>Summary</b> show it. Click it again to show every report.</p>
        <ul class="rg-list">
            @foreach (var g in groups)
            {
                var isPicked = picked?.Key == g.Key;
                var failing = g.Latest.Count(Outcome.Fail) + g.Latest.Count(Outcome.Error);
                <li class="rg @(isPicked ? "picked" : null)">
                    <button type="button" class="rg-pick" aria-pressed="@(isPicked ? "true" : "false")"
                            title="@(isPicked ? "Click again to show every report" : "Show only this run group's reports here, and in Reviews and Summary")"
                            @onclick="() => Pick(g.Key)">
                        <span class="rg-mark" aria-hidden="true">@(isPicked ? "●" : "○")</span>
                        <b class="mono">@g.Root.Reference</b>
                        <span>@(g.Root.Identity.Name ?? g.Root.Target.Display) <span class="muted small">@g.Root.Started.ToString("yyyy-MM-dd HH:mm")</span></span>
                    </button>
                    <span class="rg-chain">
                        @foreach (var run in g.Runs)
                        {
                            <a class="tier-badge tier-@run.Options.Tier" href="reports/@run.Id" title="@run.Reference">Tier @run.Options.Tier</a>
                        }
                    </span>
                    <span class="muted small">@failing fail · @g.Latest.Count(Outcome.Warning) warning</span>
                </li>
            }
        </ul>
        @if (picked is not null)
        {
            <div class="rg-open">
                <span>Reviews and Summary now show <b>@picked.Root.Reference</b>.</span>
                <a class="btn" href="@(prefix)recommendations"><Icon Kind="Lightbulb" Size="16" /> Open Reviews</a>
                <a class="btn" href="@(prefix)ai-summary"><Icon Kind="Lightbulb" Size="16" /> Open Summary</a>
            </div>
        }
    </section>
    @* Tick reports (or Select all), then delete them together. *@
    <div class="bulk-bar">
        <label class="bulk-all">
            <input type="checkbox" checked="@all" @onchange="e => SelectAll((bool)e.Value!)" />
            <span>Select all</span>
        </label>
        <span class="muted">@(_checked.Count == 0 ? $"{listed.Count} report{(listed.Count == 1 ? "" : "s")}{(picked is null ? "" : " in this run group")}" : $"{_checked.Count} of {listed.Count} checked")</span>
        <button class="btn danger-outline" disabled="@(_checked.Count == 0)" @onclick="DeleteCheckedAsync">
            <Icon Kind="Delete" Size="16" /> Delete checked@(_checked.Count > 0 ? $" ({_checked.Count})" : "")
        </button>
    </div>
    <section class="card table-scroll">
        <table class="results reports">
            <thead>
                <tr><th class="col-check-box"><input type="checkbox" checked="@all" title="Select all" aria-label="Select all reports"
                                                     @onchange="e => SelectAll((bool)e.Value!)" /></th><th>Ref</th><th>When</th><th>Tier</th><th>Device</th><th>Via</th><th class="col-bar">Outcome</th><th class="num">Fail</th><th class="num">Warn</th><th class="num">Pass</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in listed)
                {
                    var fail = r.Count(Outcome.Fail) + r.Count(Outcome.Error);
                    var warn = r.Count(Outcome.Warning);
                    var pass = r.Count(Outcome.Pass);
                    var total = Math.Max(1, fail + warn + pass);
                    var isChecked = _checked.Contains(r.Id);
                    <tr class="@(isChecked ? "checked" : null)">
                        <td class="col-check-box"><input type="checkbox" checked="@isChecked" aria-label="Check this report for deleting"
                                                         @onchange="e => Check(r.Id, (bool)e.Value!)" /></td>
                        <td class="mono"><a href="reports/@r.Id">@r.Reference</a></td>
                        <td class="when"><span>@r.Started.ToString("yyyy-MM-dd")</span> <span class="muted">@r.Started.ToString("HH:mm")</span></td>
                        @* The tier, and for a deeper run the run it follows up; for a tier 1 run, how many deeper runs follow it. *@
                        <td class="tier-cell">
                            <span class="tier-badge tier-@r.Options.Tier">Tier @r.Options.Tier</span>
                            @if (r.Options.FollowsUp is { } up)
                            {
                                <div class="small">
                                    @if (_byId!.TryGetValue(up, out var parent))
                                    {
                                        <a href="reports/@parent.Id" title="@parent.Label, @parent.Started.ToString("yyyy-MM-dd HH:mm")">follows @parent.Reference</a>
                                    }
                                    else
                                    {
                                        <span class="muted">follows a deleted run</span>
                                    }
                                </div>
                            }
                            else if (_followers!.GetValueOrDefault(r.Id) is > 0 and var deeper)
                            {
                                <div class="small"><a href="reports/@r.Id#tiers">@deeper deeper run@(deeper == 1 ? "" : "s")</a></div>
                            }
                            @if (!_all!.Any(x => x.Options.FollowsUp == r.Id) && Tiers.OutlookFor(r) is { Kind: not OutlookKind.Deepest } outlook)
                            {
                                <div class="small outlook @outlook.Kind.ToString().ToLowerInvariant()" title="@outlook.Why">tier @outlook.Tier: @outlook.Label.ToLowerInvariant()</div>
                            }
                        </td>
                        <td>
                            <a class="device" href="reports/@r.Id">@(r.Identity.Name ?? r.Target.Display)</a>
                            <div class="device-meta">
                                <span class="mono">@r.Identity.DriverVersion</span>
                                @if (r.Options.AllowMotion) { <span class="tag">motion</span> }
                                @if (r.Cancelled) { <span class="tag">stopped</span> }
                                @if (r.CommunicationLost) { <span class="tag">connection lost</span> }
                            </div>
                        </td>
                        <td><span class="via"><img src="@(r.Target.Kind == TargetKind.Com ? "com.svg" : "alpaca.png")" alt="" />@(r.Target.Kind == TargetKind.Com ? "COM" : "Alpaca")</span></td>
                        @* Fail, warning and pass as one bar: how the run went at a glance. *@
                        <td class="col-bar">
                            <div class="outcome-bar" title="@fail fail · @warn warning · @pass pass">
                                <span class="fail" style="width:@Pct(fail, total)"></span><span class="warning" style="width:@Pct(warn, total)"></span><span class="pass" style="width:@Pct(pass, total)"></span>
                            </div>
                        </td>
                        <td class="num"><span class="count @(fail > 0 ? "fail" : null)">@fail</span></td>
                        <td class="num"><span class="count @(warn > 0 ? "warning" : null)">@warn</span></td>
                        <td class="num">@pass</td>
                        <td class="actions">
                            <a class="icon-btn" href="download/@(r.Id).md" download title="Download Markdown" aria-label="Download Markdown"><Icon Kind="Download" Size="18" /></a>
                            <a class="icon-btn" href="download/@(r.Id).json" download title="Download JSON" aria-label="Download JSON"><Icon Kind="CodeBraces" Size="18" /></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    // Every saved run, and the ones shown: the top tab's own (ConformU runs, or ASCOM Conformance Check runs).
    private List<RunReport>? _all, _reports;
    private readonly HashSet<string> _checked = [];

    /// <summary>The reports the list shows: the picked run group's, or every report of this tab.</summary>
    private List<RunReport> Visible
        => RunGroups.Find(RunGroups.Build(_reports!), State.GroupId) is { } group
            ? [.. _reports!.Where(r => group.Runs.Any(x => x.Id == r.Id))] : _reports!;

    /// <summary>Picks a run group (Reviews and Summary follow it, and the list shows only its reports), or, picked again, none.</summary>
    private void Pick(string key)
    {
        State.GroupId = State.GroupId == key ? null : key;
        _checked.Clear();
    }

    // Each run by its ID, and for each tier 1 run how many runs follow up its chain.
    private Dictionary<string, RunReport>? _byId;
    private Dictionary<string, int>? _followers;

    private void Index()
    {
        _byId = _all!.GroupBy(r => r.Id).ToDictionary(g => g.Key, g => g.First());
        _followers = _all!.Where(r => r.Options.Tier > 1).GroupBy(r => Tiers.Root(r, _byId).Id).ToDictionary(g => g.Key, g => g.Count());
    }

    // Which test's reports: set by the address (conformu/reports or reports), never by the tab remembered in memory,
    // so a reload or a link opened on its own shows the right ones.
    private bool ConformUOnly => RunPageState.IsConformUPage(Nav.ToBaseRelativePath(Nav.Uri));
    private bool? _shownFor;

    protected override async Task OnInitializedAsync()
    {
        _all = await Store.ListAsync();
        Index();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet() => ShowForAddress();

    /// <summary>
    /// Going from one test's Reports to the other's keeps this page (the same component at another address, with no
    /// parameters, so Blazor doesn't set them again): follow the address here, or the list stays the other test's.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        // Only to this page's own addresses: leaving it (to a report, say) must not set the tab.
        if (Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].ToLowerInvariant() is not ("reports" or "conformu/reports")) return;
        ShowForAddress();
        StateHasChanged();
    });

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>Shows the address's test's reports, and moves the top tab to that test; ticks are cleared so none is deleted unseen.</summary>
    private void ShowForAddress()
    {
        var conformU = ConformUOnly;
        State.Tab = conformU ? RunPageTab.ConformU : RunPageTab.Conformance;
        if (_all is null || _shownFor == conformU) return;
        _shownFor = conformU;
        _reports = RunPageState.Shown(_all, conformU);
        _checked.Clear();
    }

    private static string Pct(int n, int total) => FormattableString.Invariant($"{100.0 * n / total:0.##}%");

    private void Check(string id, bool on)
    {
        if (on) _checked.Add(id);
        else _checked.Remove(id);
    }

    private void SelectAll(bool on)
    {
        _checked.Clear();
        if (on) _checked.UnionWith(Visible.Select(r => r.Id));
    }

    private async Task DeleteCheckedAsync()
    {
        var n = _checked.Count;
        if (n == 0 || !await Dialogs.ShowAsync(new ConfirmDialogModel("Delete reports",
                $"Delete {(n == 1 ? "the checked report" : $"the {n} checked reports")}? This can't be undone.", "Delete", "Cancel", danger: true)))
            return;
        foreach (var id in _checked) Store.Delete(id);
        _reports!.RemoveAll(r => _checked.Contains(r.Id));
        _all!.RemoveAll(r => _checked.Contains(r.Id));
        _checked.Clear();
        Index();
    }
}
