@page "/reports/{Id}"
@inject ReportStore Store

<PageTitle>@(_report is { } t ? $"{t.Reference} {t.Label}" : "Report") · GS Test Harness</PageTitle>

@if (_missing)
{
    <p class="muted">There's no report @Id. <a href="reports">All reports</a>.</p>
}
else if (_report is { } r)
{
    <header class="page-head">
        <h1><img class="kind" src="@(r.Target.Kind == TargetKind.Com ? "com.svg" : "alpaca.png")" alt="@r.Target.Kind" /> <span class="report-ref">@r.Reference</span> @r.Label</h1>
        <p class="muted"><a href="reports">Reports</a> / @r.Started.ToString("yyyy-MM-dd HH:mm") · @r.Target.Display@(r.Cancelled ? " · stopped early" : "")@(r.CommunicationLost ? " · stopped: communication lost" : "")</p>
    </header>

    @* The run at a glance. *@
    <div class="stats">
        <div class="stat fail"><span class="stat-value">@(r.Count(Outcome.Fail) + r.Count(Outcome.Error))</span><span class="stat-label">Fail or error</span></div>
        <div class="stat warning"><span class="stat-value">@r.Count(Outcome.Warning)</span><span class="stat-label">Warnings</span></div>
        <div class="stat pass"><span class="stat-value">@r.Count(Outcome.Pass)</span><span class="stat-label">Pass</span></div>
        <div class="stat"><span class="stat-value">@((r.Finished - r.Started)?.TotalSeconds.ToString("0") ?? "–") s</span><span class="stat-label">Duration</span></div>
    </div>

    <div class="grid">
        <section class="card facts">
            <h2>Device</h2>
            <dl>
                <dt>Name</dt><dd>@r.Identity.Name</dd>
                <dt>Description</dt><dd>@r.Identity.Description</dd>
                <dt>DriverInfo</dt><dd>@r.Identity.DriverInfo</dd>
                <dt>DriverVersion</dt><dd class="mono">@r.Identity.DriverVersion</dd>
                <dt>InterfaceVersion</dt><dd class="mono">@r.Identity.InterfaceVersion</dd>
                @if (r.Identity.ServerDescription is { } sd) { <dt>Alpaca server</dt><dd>@sd</dd> }
            </dl>
        </section>
        <section class="card facts">
            <h2>Run</h2>
            <dl>
                <dt>Report</dt><dd class="mono">@r.Reference <span class="muted small">(@r.Id)</span></dd>
                <dt>Tier</dt><dd>@Tiers.Name(r.Options.Tier)@if (r.FollowsUpReference is { } upRef) { <span class="muted">, following up @upRef</span> }</dd>
                @{ var outlook = Tiers.OutlookFor(r); }
                <dt>Next tier</dt>
                <dd>
                    @if (_chain.Any(c => c.Options.FollowsUp == r.Id)) { <span>Followed up: see Tiers below.</span> }
                    else
                    {
                        <span class="outlook @outlook.Kind.ToString().ToLowerInvariant()">@outlook.Label</span>
                        <span class="muted small">@outlook.Why@(outlook.Kind == OutlookKind.Offered ? " Start it from the Run tab, under this run's results." : "")</span>
                        <UncoveredTests Outlook="outlook" Max="8" />
                    }
                </dd>
                <dt>Server</dt><dd>@r.Target.Codebase (@(r.Target.Kind == TargetKind.Com ? "COM" : "Alpaca"))</dd>
                <dt>Motion</dt><dd>@(r.Options.AllowMotion ? "allowed" : "not allowed")</dd>
                <dt>Settings writes</dt><dd>@(r.Options.AllowSettingsWrites ? "allowed" : "not allowed")</dd>
                <dt>Duration</dt><dd>@((r.Finished - r.Started)?.TotalSeconds.ToString("0")) s</dd>
                <dt>Harness</dt><dd class="mono">@r.HarnessVersion</dd>
            </dl>
            <div class="row-actions">
                <a class="btn" href="download/@(r.Id).md" download><Icon Kind="Download" Size="16" /> Markdown</a>
                <a class="btn" href="download/@(r.Id).json" download><Icon Kind="CodeBraces" Size="16" /> JSON</a>
                <a class="btn" href="download/@(r.Id).csv" download><Icon Kind="Download" Size="16" /> CSV</a>
                <a class="btn" href="reports/@(r.Id)/print" target="_blank" rel="noopener"><Icon Kind="FileDocument" Size="16" /> Print / PDF</a>
            </div>
        </section>
    </div>

    @* The run's tiers: the tier 1 run and every run that follows it up, each linked; this one marked. *@
    @if (_chain.Count > 1 || r.Options.FollowsUp is not null)
    {
        <section class="card" id="tiers">
            <h2>Tiers</h2>
            <table class="results tier-chain">
                <thead><tr><th>Tier</th><th>Run</th><th class="num">Fail</th><th class="num">Warn</th><th>Tests</th></tr></thead>
                <tbody>
                    @foreach (var c in _chain)
                    {
                        var self = c.Id == r.Id;
                        <tr class="@(self ? "current" : null)">
                            <td class="tier-cell" style="padding-left:@((c.Options.Tier - 1) * 1.2 + .6)rem">
                                <span class="tier-badge tier-@c.Options.Tier">Tier @c.Options.Tier</span>
                            </td>
                            <td>
                                @if (self) { <strong>@c.Reference</strong> <span class="muted">· @c.Started.ToString("yyyy-MM-dd HH:mm") · this report</span> }
                                else { <a href="reports/@c.Id">@c.Reference</a> <span class="muted">· @c.Started.ToString("yyyy-MM-dd HH:mm")</span> }
                                @if (c.Options.Members is { Count: > 0 } m && c.Options.Tier > 1) { <div class="small muted">@string.Join(", ", m)</div> }
                            </td>
                            <td class="num"><span class="count @(c.Count(Outcome.Fail) + c.Count(Outcome.Error) > 0 ? "fail" : null)">@(c.Count(Outcome.Fail) + c.Count(Outcome.Error))</span></td>
                            <td class="num"><span class="count @(c.Count(Outcome.Warning) > 0 ? "warning" : null)">@c.Count(Outcome.Warning)</span></td>
                            <td class="mono small">
                                @* Tier 1: the tests that found an issue; deeper: the tests of its tier it made. *@
                                @foreach (var n in c.Options.Tier == 1 ? Issues(c) : Tiers.OwnTests(c)) { <a class="tier-test" href="help#test-@n">@n</a> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (r.Options.FollowsUp is { } up && _chain.All(c => c.Id != up))
            {
                <p class="muted small">The run this one follows up (@(r.FollowsUpReference ?? up)) has been deleted.</p>
            }
        </section>
    }

    <section class="card">
        <ResultsTable Results="r.Results" />
    </section>
}
else
{
    <p class="muted">Loading…</p>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private RunReport? _report;
    private bool _missing;
    private List<RunReport> _chain = [];

    private static IEnumerable<int> Issues(RunReport run)
        => run.Results.Where(x => x.IsProblem).Select(x => x.Number).Where(n => n > 0).Distinct().Order();

    protected override async Task OnParametersSetAsync()
    {
        try { _report = await Store.LoadAsync(Id); }
        catch (ArgumentException) { _report = null; }
        _missing = _report is null;
        _chain = _report is null ? [] : Tiers.Chain(_report, await Store.ListAsync());
    }
}
