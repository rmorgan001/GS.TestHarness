@page "/"
@implements IDisposable
@inject RunService Runs
@inject ReportStore Store
@inject TargetStore Saved
@inject Workbench Bench
@inject ServerList Servers
@inject DialogService Dialogs
@inject HomeService Home
@inject IJSRuntime JS
@inject ConnectionService Connections
@inject RunPageState State
@inject SourceLocator Locator
@inject SourceStore SourceFolders

<PageTitle>Run · GS Test Harness</PageTitle>

@* The Options tab's heading and introduction. The other two tabs' (a conformance check, a ConformU debug log test) are the
   Server card's heading, where "Server" used to be. *@
@if (State.Tab == RunPageTab.Options)
{
    <header class="page-head">
        <h1>Choose What a Run May Do</h1>
        <p class="muted">Whether a run may move the mount and write settings, and which extra checks it makes. They apply to
            both the ASCOM Conformance Check and the ConformU Debug Log Test, and are remembered for the next run. The mount's
            own settings (Mount, flip angle, timeouts) and its source code are under the server on each test.</p>
    </header>
}

@{
    var dragging = Bench.Dragging is not null && !Runs.IsRunning;
    var server = Bench.Selected;
    var log = State.Log;
}

@* Conformance test, ConformU Debug Log Test or Options, as picked in the layout's top tabs. The run's progress sits
   below while it runs; its findings only on its own test's tab. *@
<div class="subpanel">
@if (State.Tab == RunPageTab.Options)
{
    <section class="card">
        <h2>Options</h2>
        <label class="check danger">
            <input type="checkbox" @bind="_motion" disabled="@Runs.IsRunning" />
            <span><b>Move the mount</b><HelpLink Anchor="options" />: slew, sync, move axes, pulse guide, park, find home.
                <small>Use a simulator, or a real mount that's clear to move. The mount is put back (tracking, park) afterwards.</small></span>
        </label>
        <label class="check">
            <input type="checkbox" @bind="_writes" disabled="@Runs.IsRunning" />
            <span>Write settings back unchanged and try invalid values
                <small>Site, guide rates, tracking rate, settle time. Anything wrongly accepted is put back.</small></span>
        </label>
        <label class="check">
            <input type="checkbox" @bind="_setPark" disabled="@(Runs.IsRunning || !_motion)" />
            <span>Call SetPark <small>Moves the saved park position to wherever the mount is pointing.</small></span>
        </label>
        <label class="check">
            <input type="checkbox" @bind="_safety" disabled="@(Runs.IsRunning || !_motion)" />
            <span>Safety warnings before the mount moves<HelpLink Anchor="safety" />
                <small>Asks Proceed, Skip or Stop when the position, time or site look wrong, or the mount is parked, slewing or away from home. On by default.</small></span>
        </label>
        <label class="check">
            <input type="checkbox" @bind="_protocol" disabled="@(Runs.IsRunning || server?.Target.Kind == TargetKind.Com)" />
            <span>Alpaca protocol checks <small>Alpaca Server only. Management API, transaction IDs, error replies, HTTP 400, discovery.</small></span>
        </label>
        <label class="check">
            <input type="checkbox" @bind="_extended" disabled="@Runs.IsRunning" />
            <span>Extended checks <small>Adds a few minutes: tracking drift (on, off, rate offsets), several clients at once, parallel reads, connect cycles.
                A ConformU Debug Log Test turns them on by itself when its problems need them.</small></span>
        </label>
        <label class="check">
            <input type="checkbox" @bind="_disconnected" disabled="@Runs.IsRunning" />
            <span>Disconnect at the end <small>Checks NotConnected errors (only possible when no other client holds the device).</small></span>
        </label>
        <label class="check">
            <input type="checkbox" checked="@_notify" @onchange="SetNotify" />
            <span>Tell me when the run finishes or needs my answer
                <small>A short sound, and a browser notification if you allow it. For a long run you walk away from. Remembered by this browser.</small></span>
        </label>
    </section>
}
else
{
    var conformU = State.Tab == RunPageTab.ConformU;
    <div class="grid">
        @* The drop handlers sit on the card itself so a fast drop can't miss them; dragleave isn't used (it fires
           when moving over child elements). *@
        <section class="card server-box @(dragging ? "dragging" : null) @(_over ? "over" : null)"
                 @ondragenter="() => _over = true"
                 @ondragover:preventDefault
                 @ondrop="Drop"
                 @ondrop:preventDefault>
            @* The title with its description beside it (it wraps below on a narrow card). *@
            <div class="card-head">
                <h2>Server Selection:</h2>
                @if (conformU)
                {
                    <p class="muted">Drag a server from the list onto this box and drop a ConformU debug log on the card beside it.
                        The harness matches each problem ConformU found to its own checks, runs only those, and says whether each
                        problem is still there.</p>
                }
                else
                {
                    <p class="muted">Drag a server from the list onto this box. Choose the correct setting then run a full
                        conformance test against ITelescopeV4 (Alpaca Server and COM).</p>
                }
            </div>
            @if (server is null)
            {
                <div class="drop-empty">
                    <Icon Kind="Telescope" Size="28" />
                    <p><b>Drag a server here</b></p>
                    <p class="muted">from the list on the left (or select one there and press Enter).</p>
                </div>
            }
            else
            {
                <div class="picked">
                    <img class="kind-lg" src="@server.Image" alt="" />
                    <div>
                        <div class="picked-name">@server.Name</div>
                        <div class="muted">@server.KindText</div>
                        <div class="mono small">@server.Address</div>
                    </div>
                    @* Start (or Stop) beside the server it runs on: a full run here, the ConformU follow-up on its tab. *@
                    <div class="picked-actions">
                        @if (Runs.IsRunning)
                        {
                            <button class="btn stop" @onclick="Runs.Stop"><Icon Kind="Stop" Size="18" /> Stop</button>
                        }
                        else
                        {
                            @if (conformU)
                            {
                                var ready = log is { Areas.Count: > 0 };
                                <button class="btn primary" disabled="@(!ready || _starting)"
                                        title="@(!ready ? "Drop a ConformU log with problems first" : $"Check {log!.Areas.Count} problem areas on {server.Name}")"
                                        @onclick="StartConformU"><Icon Kind="Play" Size="18" /> @(_starting ? "Checking the mount…" : "Start run")</button>
                            }
                            else
                            {
                                <button class="btn primary" disabled="@_starting" title="@($"Test {server.Name}")"
                                        @onclick="Start"><Icon Kind="Play" Size="18" /> @(_starting ? "Checking the mount…" : "Start run")</button>
                            }
                            <button type="button" class="icon-btn" title="Clear" aria-label="Clear the server" @onclick="() => Bench.Select(null)">
                                <Icon Kind="Close" Size="18" />
                            </button>
                        }
                    </div>
                </div>
                @* A checklist of what to know before starting: ✓ fine, ⚠ looks wrong, ℹ for information. *@
                @if (!Runs.IsRunning)
                {
                    <ul class="preflight" aria-label="Before you start">
                        <li class="@(Connections.IsConnected(server.Id) ? "ok" : "note")"><span aria-hidden="true">@(Connections.IsConnected(server.Id) ? "✓" : "ℹ")</span>
                            @(Connections.IsConnected(server.Id) ? "Connected." : "Not connected yet: the run connects for itself.")</li>
                        @foreach (var (state, text) in Preflight(server.RunTarget, CurrentOptions()))
                        {
                            <li class="@state.ToString().ToLowerInvariant()"><span aria-hidden="true">@(state == Check.Ok ? "✓" : state == Check.Warn ? "⚠" : "ℹ")</span> @text</li>
                        }
                    </ul>
                }
                @* The server's settings, folded away: checked before each run (Start lists them, with ⚠ on any that look wrong). *@
                <details class="server-settings">
                    <summary>
                        <span class="server-settings-toggle" aria-hidden="true"><Icon Kind="ChevronRight" Size="18" /></span>
                        <span class="server-settings-title">Settings</span>
                        <span class="server-settings-warn">⚠ Check these before starting a run</span>
                    </summary>
                @* Where this server's source is, for "where to check the code": each person's own path, set here on either test. *@
                <SourceFolderField Codebase="server.Target.Codebase" Disabled="Runs.IsRunning" Changed="SaveOptions" />
                @* What the server drives: the ConformU diagnoses' recommendations follow GSServer's code path for it. Saved at once. *@
                <label class="mount-field" title="GSServer takes different code paths for its simulator and a real mount: the ConformU diagnoses and their recommendations follow this.">
                    <span>Mount<HelpLink Anchor="server-settings" /> <small class="muted">for the recommendations' code paths</small></span>
                    <select @bind="_mount" @bind:after="SaveOptions" disabled="@Runs.IsRunning">
                        <option value="@MountKind.Unknown">Not specified</option>
                        <option value="@MountKind.Simulator">Simulator</option>
                        <option value="@MountKind.RealMount">Real mount</option>
                    </select>
                </label>
                @* Which hemisphere the mount is in: the sign of SiteLatitude is checked against it, since the slews' targets follow the latitude. Saved at once. *@
                <label class="mount-field" title="The slews' targets (declination, azimuth) follow the mount's SiteLatitude, so a latitude with the wrong sign sends them to the wrong part of the sky. Say which hemisphere the mount is in and the run checks the sign.">
                    <span>Site hemisphere<HelpLink Anchor="server-settings" /> <small class="muted">checks the sign of SiteLatitude</small></span>
                    <select @bind="_hemisphere" @bind:after="SaveOptions" disabled="@Runs.IsRunning">
                        <option value="@Hemisphere.Unknown">Not specified</option>
                        <option value="@Hemisphere.North">Northern</option>
                        <option value="@Hemisphere.South">Southern</option>
                    </select>
                </label>
                @* The mount's flip zone, for the flip checks (and a ConformU run that has them). Saved at once. *@
                <label class="mount-field" title="Degrees either side of the meridian where the mount can point from either side of the pier. Inside it the flip checks use the SideOfPier command; a goto past it must flip the mount.">
                    <span>Flip angle (°)<HelpLink Anchor="server-settings" /> <small class="muted">@(_motion ? "either side of the meridian, for the flip checks" : "needs Move the mount under Options")</small></span>
                    <input type="number" min="0" max="90" step="1" class="narrow-input" @bind="_flipAngle" @bind:after="SaveOptions"
                           disabled="@(Runs.IsRunning || !_motion)" />
                </label>
                @* How long the mount gets: a slew, and any single call, before it counts as never answered. Saved at once. *@
                <div class="timeout-fields">
                    <label class="mount-field" title="How long a slew (or park, or find home) may take before it counts as never finished.">
                        <span>Slew timeout (s)</span>
                        <input type="number" min="10" class="narrow-input" @bind="_slewTimeout" @bind:after="SaveOptions" disabled="@Runs.IsRunning" />
                    </label>
                    <label class="mount-field" title="How long any single call to the mount may take before it counts as never answered.">
                        <span>Call timeout (s)</span>
                        <input type="number" min="2" class="narrow-input" @bind="_callTimeout" @bind:after="SaveOptions" disabled="@Runs.IsRunning" />
                    </label>
                </div>
                </details>
            }
            @if (dragging)
            {
                <div class="drop-zone"><span>Test @Bench.Dragging!.Name</span></div>
            }
        </section>

        @if (conformU)
        {
            @* A ConformU log: drop it, see what it found and which checks look at each problem, and run just those. *@
            <section class="card conformu">
                <div class="conformu-drop @(_fileOver ? "over" : null) @(log is null ? null : "compact")"
                     @ondragenter="FileDragEnter" @ondragleave="FileDragLeave" @ondrop="() => (_fileDepth, _fileOver) = (0, false)">
                    <InputFile OnChange="LoadLog" accept=".txt,.log" title="Drop a ConformU debug log here, or click to choose one"
                               disabled="@(Runs.IsRunning || _reading)" aria-label="ConformU debug log file" />
                    <Icon Kind="FileDocument" Size="@(log is null ? 28 : 20)" />
                    <div>
                        @if (_reading)
                        {
                            <p><b>Reading…</b></p>
                        }
                        else if (log is null)
                        {
                            <p><b>Drop a ConformU debug log here</b>, or click to choose one.</p>
                            <p class="muted small">A debug log only: run ConformU with debug logging turned on in its settings.</p>
                            <p class="muted small">Its problems are matched to the harness's checks, and the run makes only those checks.</p>
                        }
                        else
                        {
                            <p><b>@log.FileName</b> <span class="muted small">· drop another log to replace it</span></p>
                        }
                    </div>
                    @if (log is not null && !Runs.IsRunning)
                    {
                        @* Above the file input, so a click clears instead of opening the file picker. *@
                        <button type="button" class="icon-btn conformu-clear" title="Clear the ConformU log" aria-label="Clear the ConformU log"
                                @onclick="ClearLog"><Icon Kind="Close" Size="18" /></button>
                    }
                </div>
                @if (State.Error is { } error)
                {
                    <p class="conformu-error">@error</p>
                }
                @if (log is not null)
                {
                    <div class="conformu-head">
                        <div class="conformu-meta muted small">
                            @if (log.DeviceName is not null) { <span>@log.DeviceName @log.DriverVersion</span> }
                            @if (log.ConformUVersion is not null) { <span>ConformU @log.ConformUVersion</span> }
                            <span>@log.Lines.ToString("N0") lines</span>
                        </div>
                        <div class="summary">
                            <span class="chip error"><span class="chip-count">@log.Count(ConformUSeverity.Error)</span> Errors</span>
                            <span class="chip fail"><span class="chip-count">@log.Count(ConformUSeverity.Issue)</span> Issues</span>
                            <span class="chip warning"><span class="chip-count">@log.Count(ConformUSeverity.Warning)</span> Warnings</span>
                            <span class="chip info"><span class="chip-count">@log.Count(ConformUSeverity.Alert)</span> Config alerts</span>
                        </div>
                    </div>
                    @if (!log.Recognised)
                    {
                        <p class="conformu-error">This doesn't look like a ConformU log: no line had a time, a test name and an outcome (OK, INFO, ISSUE, ERROR…).</p>
                    }
                    else if (log.Areas.Count == 0)
                    {
                        <p class="muted">ConformU found no problems in this log: nothing to follow up.</p>
                    }
                    else
                    {
                        var plan = log.Plan();
                        var missing = Missing(plan);
                        <p class="muted small conformu-plan">The run checks only @string.Join(", ", plan.Members), using the
                            @string.Join(", ", plan.Groups.Where(g => g != "ConformU")) checks (the parts that touch those members),
                            reports only findings about them, then says for each problem below whether it was reproduced.
                            @if (missing.Count > 0)
                            {
                                <br /><span class="conformu-needs">Turn on @string.Join(" and ", missing) under
                                    <button type="button" class="link" @onclick="() => State.Tab = RunPageTab.Options">Options</button>,
                                    or the problems that need it are reported as not checked.</span>
                            }
                        </p>
                    }
                }
            </section>
        }
    </div>

    @if (conformU && log is { Areas.Count: > 0 })
    {
        <section class="card">
            <h2>Problems in the log <small class="muted">@log.Areas.Count areas</small></h2>
            <table class="results conformu-areas">
                <thead>
                    <tr><th class="col-outcome">ConformU</th><th class="col-member">Member</th><th>What ConformU said</th><th>Harness check</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in log.Areas)
                    {
                        <tr>
                            <td><span class="badge @SeverityCss(a.Severity)">@SeverityLabel(a.Severity)</span>
                                @if (a.Problems.Count > 1) { <span class="muted small"> ×@a.Problems.Count</span> }</td>
                            <td class="mono">@a.Member</td>
                            <td>@a.Problems[0].Message
                                <span class="muted small">(@a.Problems[0].Test, line @a.Problems[0].Line)</span></td>
                            <td>
                                @if (a.Covered)
                                {
                                    <span class="small">Existing: @string.Join(", ", a.Groups)</span>
                                }
                                else if (a.CanProbe)
                                {
                                    <span class="small">New: reads it while connected</span>
                                }
                                else
                                {
                                    <span class="small muted">None: reproduce by hand</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
</div>

@* The run's progress, and its reports when it's done; Stop stays at hand while the page scrolls. While a run is going
   the bar (with Stop) shows on every tab, the mount may be moving; once it's done, its reports and findings show only
   on the tab of the test that made it (a ConformU run under ConformU Debug Log Test, a full check under ASCOM
   Conformance Check), never under Options. *@
@{
    var runsHere = State.Tab == (Runs.ConformU is null ? RunPageTab.Conformance : RunPageTab.ConformU);
    // The tiers (where the run is in them, the next one, the re-run buttons) are part of the run bar; the card below it is the report.
    var showTiers = runsHere && Runs.Target is not null && (Runs.IsRunning || Runs.Results.Count > 0);
    // Where the run is in the tiers: tier 1 always first, each deeper tier offered only for what the one below found.
    var tier = Runs.Options?.Tier ?? 1;
    var outlook = showTiers && !Runs.IsRunning ? RunOutlook() : null;
    var next = outlook?.Next;
}
@if (Runs.IsRunning || (runsHere && (Runs.Status is not null || Runs.LastReport is not null)))
{
<div class="run-bar">
    <div class="run-bar-head">
        <h2 class="run-bar-title">Run Status:</h2>
        @* The run's status (Connecting…, Checking Motion…, Finished and saved., Stopped; the findings so far are saved.) beside the title. *@
        @if (Runs.Status is { } status)
        {
            <span class="run-status-step">@status</span>
        }
    </div>
    @if (Runs.IsRunning)
    {
        <button class="btn stop" @onclick="Runs.Stop"><Icon Kind="Stop" Size="18" /> Stop</button>
    }
    <div class="progress-wrap">
        @if (Runs.IsRunning && Runs.Progress is { } p)
        {
            <div class="progress"><div style="width:@(100.0 * p.GroupIndex / Math.Max(1, p.GroupCount))%"></div></div>
        }
        <RunClock />
    </div>
    @if (!runsHere)
    {
        @* Running from the other test's tab, or Options: say where its findings are. *@
        <span class="muted small">Findings on the @(Runs.ConformU is null ? "ASCOM Conformance Check" : "ConformU Debug Log Test") tab.</span>
    }
    @if (showTiers)
    {
        <div class="run-tiers">
        <ol class="tier-track" aria-label="Diagnostic tiers">
            @for (var i = 1; i <= Tiers.Max; i++)
            {
                var step = i;
                var state = step < tier || (step == tier && !Runs.IsRunning) ? "done"
                    : step == tier ? "running"
                    : next?.Tier == step ? "next"
                    : outlook?.Tier == step && outlook.Kind == OutlookKind.NotNeeded ? "notneeded"
                    : outlook?.Tier == step && outlook.Kind == OutlookKind.NotAvailable ? "unavailable" : "locked";
                <li class="tier-step @state" aria-current="@(step == tier ? "step" : null)">
                    <span class="tier-num" aria-hidden="true">@(state == "done" ? "✓" : state is "notneeded" or "unavailable" ? "–" : step.ToString())</span>
                    <span class="tier-text">
                        <span class="tier-name">@Tiers.Name(step)</span>
                        <span class="tier-state">@TierState(step, state, tier)</span>
                    </span>
                </li>
            }
        </ol>
        @if (outlook is { Kind: OutlookKind.NotNeeded or OutlookKind.NotAvailable })
        {
            @* No next tier: say why, and which problems no deeper test follows up. *@
            <div class="tier-none @(outlook.Kind == OutlookKind.NotNeeded ? "notneeded" : "unavailable")">
                <p class="tier-next-title">@Tiers.Name(outlook.Tier): @outlook.Label.ToLowerInvariant()</p>
                <p class="muted">@outlook.Why</p>
                <UncoveredTests Outlook="outlook" />
            </div>
        }
        @if (next is not null)
        {
            var conformUNext = next.From.ConformULog is not null;
            <div class="tier-next">
                <div class="tier-next-text">
                    <p class="tier-next-title">Diagnose further: @Tiers.Name(next.Tier)</p>
                    <p class="muted">@Tiers.Purpose(next.Tier, conformUNext)</p>
                    <div class="tier-members">
                        <span class="muted small">Tier @next.From.Options.Tier found problems with</span>
                        @foreach (var m in next.Members) { <span class="tag mono">@m</span> }
                    </div>
                    <div class="tier-members">
                        <span class="muted small">Tier @next.Tier tests</span>
                        @foreach (var n in NextNumbers(next, conformUNext)) { <a class="tag mono" href="help#test-@n">@n</a> }
                    </div>
                    <UncoveredTests Outlook="outlook!" />
                    @if (!_motion && NeedsMotion(next))
                    {
                        @if (next.Members.All(MovesMount)) { <p class="tier-note">The tests move the mount: turn on <b>Move the mount</b> under Options first.</p> }
                        else { <p class="tier-note">Some of the tests move the mount: without <b>Move the mount</b> (under Options) they are skipped.</p> }
                    }
                </div>
            </div>
        }
        </div>
    }
</div>
}

@if (showTiers && Runs.Target is { } t)
{
    <section class="card">
        <div class="report-head">
            <h2>Report: <span class="report-target">@t.Display</span>
                @if (Runs.ConformU is { } followed) { <small class="muted">following up @followed.FileName</small> }</h2>
            @* The finished run's report, at the top of the report section: open it, or download it as Markdown. *@
            @if (!Runs.IsRunning && Runs.LastReport is { } done)
            {
                <span class="report-actions">
                    <a class="btn" href="reports/@done.Id"><Icon Kind="FileDocument" Size="16" /> Open report @done.Reference</a>
                    <a class="btn" href="download/@(done.Id).md" download><Icon Kind="Download" Size="16" /> Markdown</a>
                </span>
            }
        </div>
        <ResultsTable Results="Runs.Results" Empty="Waiting for the first finding…" />
    </section>
}

@code {
    private bool _motion, _writes = true, _setPark, _protocol = true, _disconnected = true, _extended, _safety = true;
    private bool _notify;
    private int _slewTimeout = 120, _callTimeout = 15, _flipAngle = 0;
    private MountKind _mount = MountKind.Unknown;
    private Hemisphere _hemisphere = Hemisphere.Unknown;
    private bool _over;

    protected override void OnInitialized()
    {
        var options = Saved.Load().Options;
        (_motion, _writes, _setPark, _protocol, _disconnected, _slewTimeout, _callTimeout) =
            (options.AllowMotion, options.AllowSettingsWrites, options.AllowSetPark, options.IncludeProtocol, options.IncludeDisconnected,
             options.SlewTimeoutSeconds, options.CallTimeoutSeconds);
        _extended = options.Extended;
        _safety = options.SafetyWarnings;
        _flipAngle = Math.Clamp(options.FlipAngle, 0, 90);
        _mount = options.Mount;
        _hemisphere = options.SiteHemisphere;
        RecallSettings();
        Runs.Changed += OnChanged;
        MaybeShowGate(); // a run already waiting for an answer when the page opens
        Bench.Changed += OnBenchChanged;
        Servers.Changed += OnBenchChanged;
        State.Changed += OnBenchChanged;
        Connections.Changed += OnBenchChanged; // the checklist shows whether the server is connected
    }

    private void Drop()
    {
        _over = false;
        if (Runs.IsRunning) Bench.EndDrag();
        else Bench.Drop();
    }

    /// <summary>The warning shown before every run: the mount moves on its own, so the user watches it and takes responsibility.</summary>
    private const string SafetyWarning =
        "Check all Settings and make sure you understand them\n" +
        "Remove the OTAs (telescopes, cameras and anything else mounted) before you start, so a pier or tripod-leg strike can't damage them.\n" +
        "Stay with the mount and watch it for the whole run. Be ready to stop the run or cut the mount's power if it heads for the pier, a leg or a cable.";

    private RunOptions CurrentOptions() => new()
    {
        AllowMotion = _motion, AllowSettingsWrites = _writes, AllowSetPark = _motion && _setPark,
        IncludeProtocol = _protocol, IncludeDisconnected = _disconnected, Extended = _extended, SafetyWarnings = _safety,
        SlewTimeoutSeconds = Math.Max(10, _slewTimeout), CallTimeoutSeconds = Math.Max(2, _callTimeout),
        FlipAngle = Math.Clamp(_flipAngle, 0, 90), Mount = _mount, SiteHemisphere = _hemisphere
    };

    /// <summary>
    /// Remembers the options now, not only when a run starts: the run options, and the Settings section with the server
    /// on the card, so they come back when it's dragged there again.
    /// </summary>
    private void SaveOptions()
    {
        Saved.SaveOptions(CurrentOptions());
        if (Bench.Selected is { } server)
        {
            var settings = CurrentSettings(server);
            if (server.Settings != settings) Servers.Update(server with { Settings = settings });
        }
    }

    /// <summary>The Settings section's values now, for <paramref name="server"/>.</summary>
    private ServerSettings CurrentSettings(ServerEntry server) => new()
    {
        SourcePath = SourceFolders.FolderOf(server.Target.Codebase),
        Mount = _mount,
        SiteHemisphere = _hemisphere,
        FlipAngle = Math.Clamp(_flipAngle, 0, 90),
        SlewTimeoutSeconds = Math.Max(10, _slewTimeout),
        CallTimeoutSeconds = Math.Max(2, _callTimeout)
    };

    /// <summary>The server whose settings the Settings section shows.</summary>
    private string? _settingsFor;

    /// <summary>
    /// When another server is put on the card, recalls its settings (a server without any yet keeps the values shown,
    /// and saves them as its own) and points the source code lookup at its path.
    /// </summary>
    private void RecallSettings()
    {
        if (Bench.Selected is not { } server || server.Id == _settingsFor) return;
        _settingsFor = server.Id;
        if (server.Settings is not { } settings)
        {
            Servers.Update(server with { Settings = CurrentSettings(server) });
            return;
        }
        (_mount, _hemisphere, _flipAngle, _slewTimeout, _callTimeout) = (settings.Mount, settings.SiteHemisphere, Math.Clamp(settings.FlipAngle, 0, 90),
            Math.Max(10, settings.SlewTimeoutSeconds), Math.Max(2, settings.CallTimeoutSeconds));
        Saved.SaveOptions(CurrentOptions());
        var codebase = server.Target.Codebase;
        if (!string.Equals(SourceFolders.FolderOf(codebase), settings.SourcePath, StringComparison.Ordinal))
            _ = SourceFolders.SetAsync(codebase, settings.SourcePath, refresh: false);
    }

    /// <summary>
    /// The warning before a run. For a run that moves the mount it first connects to the mount and reads whether it's at
    /// the home position; the one dialog then shows the safety warning, plus the "put the mount in the home position"
    /// section when it isn't home. Start keeps the mount connected (as if connected from the sidebar); Cancel
    /// disconnects it. Returns whether the user went on.
    /// </summary>
    private enum Check { Ok, Warn, Note }

    /// <summary>
    /// What to know before starting, for the Server card's checklist (and the start dialog's ⚠ lines): the Mount (which code
    /// paths the recommendations name), the Site hemisphere, the source code folder, the timeouts, Move the mount and the
    /// safety warnings. Warn is something that looks wrong; Note is for information.
    /// </summary>
    private List<(Check State, string Text)> Preflight(TestTarget target, RunOptions options)
    {
        var items = new List<(Check, string)>();
        items.Add(options.Mount == MountKind.Unknown
            ? (Check.Warn, "Mount: not specified. The recommendations will list both the simulator's and the real mount's code. Set it if you know which this is.")
            : (Check.Ok, $"Mount: {(options.Mount == MountKind.Simulator ? "Simulator" : "real mount")}."));
        items.Add(options.SiteHemisphere == Hemisphere.Unknown
            ? (Check.Note, "Site hemisphere: not set, so the sign of SiteLatitude isn't checked.")
            : (Check.Ok, $"Site hemisphere: {(options.SiteHemisphere == Hemisphere.North ? "northern" : "southern")}."));
        items.Add(Locator.RootOf(target.Codebase) is { } root
            ? (Check.Ok, $"Source code: {root}")
            : (Check.Warn, "Source code: none set (or not found), so there's no code review and findings won't name the code to check. Set it under the server's Settings."));
        items.Add(options.SlewTimeoutSeconds < 60 && options.AllowMotion && options.Mount != MountKind.Simulator
            ? (Check.Warn, $"Timeouts: slew {options.SlewTimeoutSeconds} s, call {options.CallTimeoutSeconds} s. A long slew or a meridian flip on a real mount can take longer than {options.SlewTimeoutSeconds} s and would count as never finished.")
            : (Check.Ok, $"Timeouts: slew {options.SlewTimeoutSeconds} s, call {options.CallTimeoutSeconds} s."));
        items.Add(options.AllowMotion
            ? (Check.Note, "Move the mount is on: the run will slew, flip, park and home the mount. Remove the OTAs first.")
            : (Check.Note, "Move the mount is off: no slews, no park or home tests."));
        if (options.AllowMotion)
            items.Add(options.SafetyWarnings
                ? (Check.Ok, "Safety warnings before the mount moves: on.")
                : (Check.Note, "Safety warnings before the mount moves: off, so the run won't ask first."));
        return items;
    }

    /// <summary>The settings that look wrong for this run, for the start dialog: each a ⚠ line.</summary>
    private List<string> SettingsWarnings(TestTarget target, RunOptions options)
        => [.. Preflight(target, options).Where(i => i.State == Check.Warn).Select(i => "⚠ " + i.Text)];

    private bool _starting;

    private async Task<bool> ConfirmStartAsync(string title, TestTarget target, RunOptions options)
    {
        // A second click while the mount is being connected and read (it can take a while) would connect it twice.
        if (_starting) return false;
        _starting = true;
        HomeSession? home = null;
        try
        {
            HomeStatus? status = null;
            if (options.AllowMotion)
            {
                home = Home.Open(target, options);
                status = await home.CheckAsync();
            }
            var accepted = await Dialogs.ShowAsync(new StartDialogModel(title, SafetyWarning, home, status, SettingsWarnings(target, options)));
            if (accepted && home is not null && Servers.FindDevice(target)?.Id is { } id)
                home.TryHandOver(session => Connections.Adopt(id, session));
            return accepted;
        }
        finally
        {
            if (home is not null) await home.DisposeAsync();
            _starting = false;
        }
    }

    private async Task Start()
    {
        if (Bench.Selected is not { } server) return;
        if (Runs.IsRunning) return;
        var options = CurrentOptions();
        if (!await ConfirmStartAsync("Safety Warning!", server.RunTarget, options) || Runs.IsRunning) return;
        Saved.SaveOptions(options);
        Runs.Start(server.RunTarget, options, chain: true);
    }

    // ---------- ConformU log ----------

    private bool _fileOver, _reading;

    // dragenter and dragleave also fire for the elements inside the drop area, so count them.
    private int _fileDepth;

    private void FileDragEnter()
    {
        _fileDepth++;
        // A server dragged from the list isn't a file.
        _fileOver = Bench.Dragging is null;
    }

    private void FileDragLeave()
    {
        _fileDepth = Math.Max(0, _fileDepth - 1);
        if (_fileDepth == 0) _fileOver = false;
    }

    private async Task LoadLog(InputFileChangeEventArgs e)
    {
        _fileOver = false;
        var file = e.File;
        if (file.Size > RunPageState.MaxBytes)
        {
            State.Error = $"{file.Name} is {file.Size / 1048576.0:0} MB; the largest log accepted is {RunPageState.MaxBytes / 1048576} MB.";
            return;
        }
        _reading = true;
        State.Error = null;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(RunPageState.MaxBytes);
            using var reader = new StreamReader(stream);
            var parsed = await ConformULog.ParseAsync(file.Name, reader);
            // Debug logs only. A file that isn't a ConformU log at all is kept, so the card can say so.
            if (parsed.Recognised && !parsed.IsDebug)
            {
                State.Log = null;
                State.Error = $"{file.Name} is a normal ConformU log, not a debug log: it has no DEBUG lines. " +
                              "Turn on debug logging in ConformU's settings, run it again and drop the new log.";
            }
            else State.Log = parsed;
        }
        catch (Exception ex)
        {
            State.Error = $"{file.Name} couldn't be read: {ex.Message}";
        }
        finally
        {
            _reading = false;
        }
    }

    private void ClearLog()
    {
        State.Log = null;
        State.Error = null;
    }

    /// <summary>The Run-page options the plan needs that aren't ticked (motion is never turned on for you).</summary>
    private List<string> Missing(ConformUPlan plan)
    {
        var missing = new List<string>();
        if (plan.NeedsMotion && !_motion) missing.Add("Move the mount");
        if (plan.NeedsWrites && !_writes) missing.Add("Write settings");
        if (plan.NeedsProtocol && !_protocol && Bench.Selected?.Target.Kind != TargetKind.Com) missing.Add("Alpaca protocol checks");
        if (plan.NeedsDisconnected && !_disconnected) missing.Add("Disconnect at the end");
        return missing;
    }

    /// <summary>
    /// Runs only the groups that check the log's problems, then the ConformU checks. Extended checks are turned on when
    /// the plan has tracking or client problems (only those groups run); motion and writes stay as ticked.
    /// </summary>
    private async Task StartConformU()
    {
        if (Bench.Selected is not { } server || State.Log is not { } log) return;
        if (Runs.IsRunning) return;
        var plan = log.Plan();
        var options = CurrentOptions();
        if (!await ConfirmStartAsync("Safety Warning!", server.RunTarget, options) || Runs.IsRunning) return;
        Saved.SaveOptions(options);
        // Only the log's problem members: the groups skip the sections that don't touch them, and only findings about them are kept.
        options = options with { Groups = plan.Groups, Members = plan.Members, Extended = options.Extended || plan.NeedsExtended };
        Runs.Start(server.RunTarget, options, log, chain: true);
    }

    // ---------- Tiers 2 and 3 ----------

    /// <summary>The deeper tier the last run can be followed up with.</summary>
    private NextTier? NextTier() => RunOutlook()?.Next;

    /// <summary>What the tier after the last run would do.</summary>
    private Outlook? RunOutlook() => Runs.LastReport is { } last ? Tiers.OutlookFor(last) : null;

    /// <summary>A tier step's line under its name on the tier track.</summary>
    private string TierState(int step, string state, int tier) => state switch
    {
        "running" => "Running now",
        "done" when step < tier => $"Done: followed up by tier {tier}" ,
        "done" when step == Tiers.Max => "Done: see the Summary findings",
        "done" => "Done",
        "next" => "Available for the problems found",
        "notneeded" => "Not needed",
        "unavailable" => "Not available: no test for what was found",
        _ when Runs.IsRunning => "After this run",
        _ when step == tier + 1 => "Nothing found that it can take further",
        _ when step > tier + 1 => "Not reached",
        _ => $"After tier {step - 1}"
    };

    /// <summary>The numbers of the tests the next tier makes for its members (ConformU.Diagnose… or Diagnose…).</summary>
    private static IEnumerable<int> NextNumbers(NextTier next, bool conformU)
        => next.Members.Select(m => Tiers.Diagnosis(m, next.Tier)).OfType<Diagnosis>()
            .SelectMany(d => d.Produces).Where(k => k.StartsWith("ConformU.") == conformU)
            .Select(TestNumbers.For).Where(n => n > 0).Distinct().Order();

    private static bool MovesMount(string member) => GS.TestHarness.Engine.Checks.AreaDiagnostics.MovesMount(member);

    private static bool NeedsMotion(NextTier next) => next.Members.Any(MovesMount);

    private static string SeverityCss(ConformUSeverity s) => s switch
    {
        ConformUSeverity.Error => "error",
        ConformUSeverity.Issue => "fail",
        ConformUSeverity.Warning => "warning",
        _ => "info"
    };

    private static string SeverityLabel(ConformUSeverity s) => s switch
    {
        ConformUSeverity.Error => "Error",
        ConformUSeverity.Issue => "Issue",
        ConformUSeverity.Warning => "Warning",
        _ => "Config"
    };

    private void OnBenchChanged() => _ = InvokeAsync(() =>
    {
        if (Bench.Dragging is null) _over = false;
        if (!Runs.IsRunning) RecallSettings();
        StateHasChanged();
    });

    // Findings arrive quickly; redraw at most a few times a second.
    private DateTime _lastRender;
    private bool _pending;

    // The run asks before it moves the mount when something looks unsafe: Proceed, Skip or Stop (see MotionGate).
    private bool _gateShowing;
    private GateDialogModel? _gateModel;

    private void MaybeShowGate()
    {
        if (Runs.PendingGate is null || _gateShowing) return;
        _gateShowing = true;
        _ = InvokeAsync(ShowGateAsync);
    }

    private async Task ShowGateAsync()
    {
        try
        {
            if (Runs.PendingGate is not { } request) return;
            var model = new GateDialogModel(request);
            _gateModel = model;
            await Dialogs.ShowAsync(model);
            // Closed any other way than a button (Escape): Stop, the safe answer.
            if (!model.Abandoned) Runs.ResolveGate(request, model.Decision ?? GateDecision.Stop);
        }
        finally
        {
            _gateModel = null;
            _gateShowing = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            // This browser's choice about sounds and notifications.
            var on = await JS.InvokeAsync<bool>("gsNotify.enabled");
            if (on != _notify)
            {
                _notify = on;
                StateHasChanged();
            }
        }
        catch (Exception) { /* no browser to ask */ }
    }

    private async Task SetNotify(ChangeEventArgs e)
    {
        _notify = e.Value is true;
        try { await JS.InvokeVoidAsync("gsNotify.set", _notify); }
        catch (Exception) { /* no browser to ask */ }
    }

    private void OnChanged()
    {
        // Answered in another tab: close this one's question.
        if (_gateModel is { } shown && !ReferenceEquals(Runs.PendingGate, shown.Request)) shown.Abandon();
        MaybeShowGate();
        var now = DateTime.UtcNow;
        if (!Runs.IsRunning || (now - _lastRender).TotalMilliseconds > 250)
        {
            _lastRender = now;
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        if (_pending) return;
        _pending = true;
        _ = Task.Delay(300).ContinueWith(_ =>
        {
            _pending = false;
            _lastRender = DateTime.UtcNow;
            return InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        // Leaving the page with the question open closes it without answering: the run waits, and the page asks again when it is back.
        _gateModel?.Abandon();
        Runs.Changed -= OnChanged;
        Bench.Changed -= OnBenchChanged;
        Servers.Changed -= OnBenchChanged;
        State.Changed -= OnBenchChanged;
        Connections.Changed -= OnBenchChanged;
    }
}
