@page "/compare"
@implements IDisposable
@inject ReportStore Store
@inject SiteStore Sites
@inject Workbench Bench
@inject ServerList Servers
@inject RunService Runs

<PageTitle>Compare · GS Test Harness</PageTitle>

@* No picking of runs: the server on the Run tab, and its latest run at each site ticked there, side by side. *@
<header class="page-head">
    <h1>Compare sites</h1>
    <p class="muted">How the server on the Run tab does at each site ticked there (server's own, north, south): its latest
        run at each, side by side.</p>
</header>

@if (_all is null)
{
    <p class="muted">Loading…</p>
}
else if (Bench.Selected is not { } server)
{
    <p class="muted">Drag a server onto the Server box on the <a href="">Run</a> tab first.</p>
}
else
{
    var columns = Columns(server);
    <section class="card">
        <div class="picked">
            <img class="kind-lg" src="@server.Image" alt="" />
            <div>
                <div class="picked-name">@server.Name</div>
                <div class="muted">@server.KindText</div>
                <div class="mono small">@server.Address</div>
            </div>
        </div>
        @if (columns.Count == 0)
        {
            <p class="muted">No site is ticked on the <a href="">Run</a> tab.</p>
        }
        else
        {
            <ul class="site-runs">
                @foreach (var (site, run) in columns)
                {
                    <li>
                        <b>@SiteName(site)</b>
                        @if (run is null) { <span class="muted">no run yet</span> }
                        else
                        {
                            <a href="reports/@run.Id">@run.Started.ToString("yyyy-MM-dd HH:mm")</a>
                            <span class="muted">@run.Identity.DriverVersion · @(run.Count(Outcome.Fail) + run.Count(Outcome.Error)) fail</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    var runs = columns.Where(c => c.Run is not null).ToList();
    if (runs.Count < 2)
    {
        <p class="muted">Runs at two or more of the ticked sites are needed to compare. Start them on the <a href="">Run</a> tab.</p>
    }
    else
    {
        var rows = ReportComparer.CompareSites([.. runs.Select(c => c.Run!)]);
        <div class="summary">
            @foreach (var c in Shown)
            {
                <button class="chip @Css(c) @(_filter == c ? "on" : "")" @onclick="() => _filter = _filter == c ? null : c">
                    <span class="chip-count">@rows.Count(d => d.Change == c)</span> @Label(c)
                </button>
            }
        </div>
        <section class="card table-scroll">
            <table class="results">
                <thead>
                    <tr>
                        <th class="col-sites">Sites</th><th class="col-check">Check</th>
                        @foreach (var (site, _) in runs) { <th>@SiteName(site)</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in rows.Where(d => _filter is null ? d.Change != SiteChange.Same : d.Change == _filter))
                    {
                        <tr class="row">
                            <td><span class="badge @Css(d.Change)">@Label(d.Change)</span></td>
                            @* The fix once, under the check: the same advice at every site. *@
                            <td><span class="mono">@d.Id</span>
                                @if (d.Results.FirstOrDefault(r => r is { Outcome: not Outcome.Pass, Fix: not null }) is { } bad) { <div class="fix small">@bad.Fix</div> }</td>
                            @foreach (var r in d.Results)
                            {
                                <td>@if (r is null) { <span class="muted">not checked</span> }
                                    else { <span class="badge @ResultsTable.Css(r.Outcome)">@r.Outcome</span> @r.Message }</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private List<RunReport>? _all;  // every saved run, newest first
    private SiteChange? _filter;
    private string? _lastRun;

    private static readonly SiteChange[] Shown = [SiteChange.Differs, SiteChange.FailsEverywhere, SiteChange.NotEverywhere, SiteChange.Same];

    protected override async Task OnInitializedAsync()
    {
        _lastRun = Runs.LastReport?.Id;
        _all = await Store.ListAsync();
        Sites.Changed += OnChanged;
        Bench.Changed += OnChanged;
        Servers.Changed += OnChanged;
        Runs.Changed += OnRunsChanged;
    }

    /// <summary>
    /// Each ticked site (null: the server's own) and the server's run there, if any: the same run the
    /// Recommendations tab uses (<see cref="ReportStore.LatestAt"/>).
    /// </summary>
    private List<(SiteLocation? Site, RunReport? Run)> Columns(ServerEntry server)
        => [.. Sites.Selected().Select(site => (site, ReportStore.LatestAt(_all!, server.Target, site?.Hemisphere)))];

    private static string SiteName(SiteLocation? site) => site?.Label ?? "Server's own site";

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>A run finished: list it.</summary>
    private void OnRunsChanged() => InvokeAsync(async () =>
    {
        if (Runs.IsRunning || Runs.LastReport?.Id == _lastRun) return;
        _lastRun = Runs.LastReport?.Id;
        _all = await Store.ListAsync();
        StateHasChanged();
    });

    private static string Css(SiteChange c) => c switch
    {
        SiteChange.Differs => "fail",
        SiteChange.FailsEverywhere => "warning",
        SiteChange.Same => "pass",
        _ => "skipped"
    };

    private static string Label(SiteChange c) => c switch
    {
        SiteChange.Differs => "Differs",
        SiteChange.FailsEverywhere => "Fails at every site",
        SiteChange.NotEverywhere => "Not checked everywhere",
        _ => "Same, no problem"
    };

    public void Dispose()
    {
        Sites.Changed -= OnChanged;
        Bench.Changed -= OnChanged;
        Servers.Changed -= OnChanged;
        Runs.Changed -= OnRunsChanged;
    }
}
