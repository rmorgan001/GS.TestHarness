@page "/compare"
@implements IDisposable
@inject ReportStore Store
@inject SiteStore Sites
@inject Workbench Bench
@inject ServerList Servers
@inject RunService Runs

<PageTitle>Compare · GS Test Harness</PageTitle>

@* Sites: the server on the Run tab, and its latest run at each site ticked there, side by side.
   Versions: two runs of that server (by default its newest and the newest earlier one with another DriverVersion),
   check by check, for regressions across driver versions. *@
<header class="page-head">
    <h1>Compare</h1>
    <p class="muted">@(_mode == Mode.Sites
        ? "How the server on the Run tab does at each site ticked there (server's own, north, south): its latest run at each, side by side."
        : "Two runs of the server on the Run tab, check by check: what a new driver version fixed, broke or changed.")</p>
    <div class="seg compare-mode" role="group" aria-label="Compare">
        <button class="@(_mode == Mode.Sites ? "on" : null)" @onclick="() => _mode = Mode.Sites">Sites</button>
        <button class="@(_mode == Mode.Versions ? "on" : null)" @onclick="() => _mode = Mode.Versions">Versions</button>
    </div>
</header>

@if (_all is null)
{
    <p class="muted">Loading…</p>
}
else if (Bench.Selected is not { } server)
{
    <p class="muted">Drag a server onto the Server box on the <a href="">Run</a> tab first.</p>
}
else if (_mode == Mode.Versions)
{
    var device = _all.Where(r => TestTarget.SameDevice(r.Target, server.Target)).ToList();
    if (Pair(device) is not { } pair)
    {
        <p class="muted">Two or more runs of @server.Name are needed to compare. Start them on the <a href="">Run</a> tab.</p>
    }
    else
    {
        var (before, after) = pair;
        var rows = ReportComparer.Compare(before, after);
        var differences = ReportComparer.Differences(before, after);
        <section class="card versions-pick">
            <label class="field">
                <span class="field-label">Before</span>
                <select value="@before.Id" @onchange="e => _beforeId = e.Value?.ToString()">
                    @foreach (var r in device) { <option value="@r.Id">@RunText(r)</option> }
                </select>
            </label>
            <label class="field">
                <span class="field-label">After</span>
                <select value="@after.Id" @onchange="e => _afterId = e.Value?.ToString()">
                    @foreach (var r in device) { <option value="@r.Id">@RunText(r)</option> }
                </select>
            </label>
            <a class="btn" href="download/compare/@(before.Id)/@(after.Id).csv" download><Icon Kind="Download" Size="16" /> CSV</a>
        </section>
        @if (before.Id == after.Id)
        {
            <p class="muted">Before and after are the same run: pick two different runs.</p>
        }
        else
        {
            @if (differences.Count > 0)
            {
                <p class="target-note">Not like for like: @string.Join("; ", differences). Expect checks gone or added that aren't regressions.</p>
            }
            <div class="summary">
                @foreach (var c in VersionChanges)
                {
                    <button class="chip @Css(c) @(_versionFilter == c ? "on" : "")" @onclick="() => _versionFilter = _versionFilter == c ? null : c">
                        <span class="chip-count">@rows.Count(d => d.Change == c)</span> @Label(c)
                    </button>
                }
            </div>
            <section class="card table-scroll">
                <table class="results">
                    <thead>
                        <tr>
                            <th class="col-sites">Change</th><th class="col-check">Check</th>
                            <th>Before · @before.Identity.DriverVersion</th><th>After · @after.Identity.DriverVersion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in rows.Where(d => _versionFilter is null ? d.Change is not (Change.Same or Change.Added) : d.Change == _versionFilter))
                        {
                            <tr class="row">
                                <td><span class="badge @Css(d.Change)">@Label(d.Change)</span></td>
                                <td><span class="mono">@d.Id</span>
                                    @if ((d.After ?? d.Before) is { Outcome: not Outcome.Pass, Fix: { } fix }) { <div class="fix small">@fix</div> }</td>
                                @foreach (var r in new[] { d.Before, d.After })
                                {
                                    <td>@if (r is null) { <span class="muted">not checked</span> }
                                        else { <span class="badge @ResultsTable.Css(r.Outcome)">@r.Outcome</span> @r.Message }</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
}
else
{
    var columns = Columns(server);
    <section class="card">
        <div class="picked">
            <img class="kind-lg" src="@server.Image" alt="" />
            <div>
                <div class="picked-name">@server.Name</div>
                <div class="muted">@server.KindText</div>
                <div class="mono small">@server.Address</div>
            </div>
        </div>
        @if (columns.Count == 0)
        {
            <p class="muted">No site is ticked on the <a href="">Run</a> tab.</p>
        }
        else
        {
            <ul class="site-runs">
                @foreach (var (site, run) in columns)
                {
                    <li>
                        <b>@SiteName(site)</b>
                        @if (run is null) { <span class="muted">no run yet</span> }
                        else
                        {
                            <a href="reports/@run.Id">@run.Started.ToString("yyyy-MM-dd HH:mm")</a>
                            <span class="muted">@run.Identity.DriverVersion · @(run.Count(Outcome.Fail) + run.Count(Outcome.Error)) fail</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    var runs = columns.Where(c => c.Run is not null).ToList();
    if (runs.Count < 2)
    {
        <p class="muted">Runs at two or more of the ticked sites are needed to compare. Start them on the <a href="">Run</a> tab.</p>
    }
    else
    {
        var rows = ReportComparer.CompareSites([.. runs.Select(c => c.Run!)]);
        <div class="summary">
            @foreach (var c in Shown)
            {
                <button class="chip @Css(c) @(_filter == c ? "on" : "")" @onclick="() => _filter = _filter == c ? null : c">
                    <span class="chip-count">@rows.Count(d => d.Change == c)</span> @Label(c)
                </button>
            }
        </div>
        <section class="card table-scroll">
            <table class="results">
                <thead>
                    <tr>
                        <th class="col-sites">Sites</th><th class="col-check">Check</th>
                        @foreach (var (site, _) in runs) { <th>@SiteName(site)</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in rows.Where(d => _filter is null ? d.Change != SiteChange.Same : d.Change == _filter))
                    {
                        <tr class="row">
                            <td><span class="badge @Css(d.Change)">@Label(d.Change)</span></td>
                            @* The fix once, under the check: the same advice at every site. *@
                            <td><span class="mono">@d.Id</span>
                                @if (d.Results.FirstOrDefault(r => r is { Outcome: not Outcome.Pass, Fix: not null }) is { } bad) { <div class="fix small">@bad.Fix</div> }</td>
                            @foreach (var r in d.Results)
                            {
                                <td>@if (r is null) { <span class="muted">not checked</span> }
                                    else { <span class="badge @ResultsTable.Css(r.Outcome)">@r.Outcome</span> @r.Message }</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private List<RunReport>? _all;  // every saved run, newest first
    private SiteChange? _filter;

    private enum Mode { Sites, Versions }
    private Mode _mode = Mode.Sites;
    private string? _beforeId, _afterId; // the runs picked (null: the default pair)
    private Change? _versionFilter;

    private static readonly Change[] VersionChanges =
        [Change.Regressed, Change.New, Change.Changed, Change.StillFailing, Change.Fixed, Change.Gone, Change.Added, Change.Same];

    /// <summary>The runs picked, or the default pair (<see cref="ReportComparer.DefaultVersionPair"/>) where none is.</summary>
    private (RunReport Before, RunReport After)? Pair(List<RunReport> device)
    {
        if (ReportComparer.DefaultVersionPair(device) is not { } d) return null;
        var before = device.FirstOrDefault(r => r.Id == _beforeId) ?? d.Before;
        var after = device.FirstOrDefault(r => r.Id == _afterId) ?? d.After;
        return (before, after);
    }

    private static string RunText(RunReport r)
        => $"{r.Started:yyyy-MM-dd HH:mm} · {r.Identity.DriverVersion ?? "?"} · {r.SiteLabel}" +
           (r.Cancelled || r.CommunicationLost ? " · stopped" : "") + $" · {r.Count(Outcome.Fail) + r.Count(Outcome.Error)} fail";

    private static string Css(Change c) => c switch
    {
        Change.Regressed or Change.New => "fail",
        Change.Changed or Change.StillFailing => "warning",
        Change.Fixed or Change.Same => "pass",
        _ => "skipped"
    };

    private static string Label(Change c) => c switch
    {
        Change.Regressed => "Regressed",
        Change.New => "New problem",
        Change.Changed => "Problem changed",
        Change.StillFailing => "Still failing",
        Change.Fixed => "Fixed",
        Change.Gone => "Not checked after",
        Change.Added => "New check, fine",
        _ => "Same, no problem"
    };
    private string? _lastRun;

    private static readonly SiteChange[] Shown = [SiteChange.Differs, SiteChange.FailsEverywhere, SiteChange.NotEverywhere, SiteChange.Same];

    protected override async Task OnInitializedAsync()
    {
        _lastRun = Runs.LastReport?.Id;
        _all = await Store.ListAsync();
        Sites.Changed += OnChanged;
        Bench.Changed += OnChanged;
        Servers.Changed += OnChanged;
        Runs.Changed += OnRunsChanged;
    }

    /// <summary>
    /// Each ticked site (null: the server's own) and the server's run there, if any: the same run the
    /// Recommendations tab uses (<see cref="ReportStore.LatestAt"/>).
    /// </summary>
    private List<(SiteLocation? Site, RunReport? Run)> Columns(ServerEntry server)
        => [.. Sites.Selected().Select(site => (site, ReportStore.LatestAt(_all!, server.Target, site?.Hemisphere)))];

    private static string SiteName(SiteLocation? site) => site?.Label ?? "Server's own site";

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>A run finished: list it.</summary>
    private void OnRunsChanged() => InvokeAsync(async () =>
    {
        if (Runs.IsRunning || Runs.LastReport?.Id == _lastRun) return;
        _lastRun = Runs.LastReport?.Id;
        _all = await Store.ListAsync();
        StateHasChanged();
    });

    private static string Css(SiteChange c) => c switch
    {
        SiteChange.Differs => "fail",
        SiteChange.FailsEverywhere => "warning",
        SiteChange.Same => "pass",
        _ => "skipped"
    };

    private static string Label(SiteChange c) => c switch
    {
        SiteChange.Differs => "Differs",
        SiteChange.FailsEverywhere => "Fails at every site",
        SiteChange.NotEverywhere => "Not checked everywhere",
        _ => "Same, no problem"
    };

    public void Dispose()
    {
        Sites.Changed -= OnChanged;
        Bench.Changed -= OnChanged;
        Servers.Changed -= OnChanged;
        Runs.Changed -= OnRunsChanged;
    }
}
