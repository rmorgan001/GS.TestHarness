@page "/recommendations"
@page "/conformu/recommendations"
@implements IDisposable
@inject ReportStore Store
@inject RunService Runs
@inject RunPageState State
@inject NavigationManager Nav

<PageTitle>Reviews · GS Test Harness</PageTitle>

@* Every problem the latest runs found, once per check and server, with what to change and where. Older runs of a
   device are left out, so a problem fixed since doesn't come back. *@
<header class="page-head">
    <h1>Reviews</h1>
    <p class="muted">Every check that found a problem in the latest @(ConformUOnly ? "ConformU Debug Log Test run" : "ASCOM Conformance Check run") of each
        device, with the recommended fix and where the code probably is. Each server is listed apart: the
        fix is in its own code.</p>
</header>

<RunGroupBanner Group="_group" />

@if (_set is null)
{
    <p class="muted">Loading…</p>
}
else if (_set.Runs.Count == 0)
{
    <div class="empty-state"><Icon Kind="Lightbulb" Size="32" /><p>@(ConformUOnly ? "No ConformU runs yet." : "No ASCOM Conformance Check runs yet.")</p><a class="btn primary" href="">Start one</a></div>
}
else
{
    // The chips count what the server and search filters leave, so they match the cards below.
    var filtered = Filtered;
    var shown = filtered.Where(r => _outcomes.Count == 0 || _outcomes.Contains(r.Worst)).ToList();
    var runsOf = _set.Runs.GroupBy(r => r.Target.Codebase).ToDictionary(g => g.Key, g => g.Count());
    var clean = _set.Clean.Where(c => (_codebase.Length == 0 || c.Codebase.ToString() == _codebase) && Matches(c.Id, c.Member)).ToList();
    <section class="card">
        <div class="rec-runs-head">
            <span class="muted">From @_set.Runs.Count latest run@(_set.Runs.Count == 1 ? "" : "s")</span>
            <a class="btn" href="@(ConformUOnly ? "download/conformu/recommendations.md" : "download/recommendations.md")" download><Icon Kind="Download" Size="16" /> Download Markdown</a>
        </div>
        <ul class="run-list">
            @foreach (var run in _set.Runs)
            {
                <li>
                    <b>@run.Target.Codebase.ServerType()</b>
                    <a href="reports/@run.Id">@run.Reference</a> <span class="muted">@run.Started.ToString("yyyy-MM-dd HH:mm")</span>
                    <span class="muted">@run.Label · @(run.Count(Outcome.Fail) + run.Count(Outcome.Error)) fail · @run.Count(Outcome.Warning) warning</span>
                    @if (run.Cancelled) { <span class="tag" title="No finished run of this device">stopped</span> }
                </li>
            }
        </ul>
    </section>

    <div class="summary">
        @foreach (var outcome in Problems)
        {
            <button class="chip @ResultsTable.Css(outcome) @(_outcomes.Contains(outcome) ? "on" : "")" @onclick="() => Toggle(outcome)"
                    title="Show @outcome (click again to hide it; with none picked, all show)">
                <span class="chip-count">@filtered.Count(r => r.Worst == outcome)</span> @ResultsTable.Label(outcome)
            </button>
        }
        <button class="chip pass @(_showClean ? "on" : "")" @onclick="() => _showClean = !_showClean" title="Also list the checks that found no problem">
            <span class="chip-count">@clean.Count</span> No problem
        </button>
        <span class="spacer"></span>
        <select @bind="_codebase" aria-label="Server">
            <option value="">All servers</option>
            @foreach (var c in _set.Runs.Select(r => r.Target.Codebase).Distinct())
            {
                <option value="@c">@c.ServerType()</option>
            }
        </select>
        <input type="search" placeholder="Search" @bind="_search" @bind:event="oninput" aria-label="Search recommendations" />
    </div>

    @if (_set.Recommendations.Count == 0)
    {
        <p class="muted empty">The latest runs found no problems.</p>
    }
    else if (shown.Count == 0)
    {
        <p class="muted empty">No recommendations match the filter.</p>
    }

    @foreach (var server in shown.GroupBy(r => r.Codebase))
    {
        <h2 class="rec-server">@server.Key.ServerType() <span class="muted">(@server.Count())</span></h2>
        @foreach (var r in server)
        {
            <article class="card rec">
                <div class="rec-head">
                    @* The tier of the test that found it: the first digit of its test number (1001 on is tier 1, 2001 tier 2, 3001 tier 3). *@
                    @if (TestNumbers.TierOf(TestNumbers.Of(r.Id)) is > 0 and var tier)
                    {
                        <span class="tier-tag tier-@tier" title="Found by a tier @tier test (test @TestNumbers.Of(r.Id))">Tier @tier</span>
                    }
                    <span class="badge @ResultsTable.Css(r.Worst)">@ResultsTable.Label(r.Worst)</span>
                    <span class="rec-member mono">@r.Member</span>
                    <span class="mono muted small">@TestNumbers.Label(r.Id)</span>
                    <span class="spacer"></span>
                    @{ var of = runsOf.GetValueOrDefault(r.Codebase); }
                    <span class="muted small">@r.Hits.Count of @of run@(of == 1 ? "" : "s")</span>
                </div>
                <dl class="rec-body">
                    <dt>Recommendation</dt>
                    <dd>
                        @if (r.Fixes.Count == 0)
                        {
                            <span class="muted">None recorded for this check. The expected and actual values below show what to change.</span>
                        }
                        @foreach (var fix in r.Fixes) { <div class="fix">@fix</div> }
                    </dd>
                    @if (r.Sources.Count > 0)
                    {
                        <dt>Code to check</dt>
                        <dd>@foreach (var source in r.Sources) { <div class="mono">@source</div> }</dd>
                    }
                    @if (r.Reference is not null)
                    {
                        <dt>Reference</dt>
                        <dd><a href="@r.Reference" target="_blank" rel="noopener">@r.Reference</a></dd>
                    }
                    <dt>Found in</dt>
                    <dd>
                        <ul class="rec-hits">
                            @foreach (var hit in r.Hits)
                            {
                                <li>
                                    <span class="badge @ResultsTable.Css(hit.Result.Outcome)">@ResultsTable.Label(hit.Result.Outcome)</span>
                                    <a href="reports/@hit.Run.Id">@hit.Run.Reference</a> <span class="muted small">@hit.Run.Label</span>
                                    <span>@hit.Result.Message</span>
                                    @if (hit.Result.Expected is not null) { <div class="small muted">Expected: @hit.Result.Expected</div> }
                                    @if (hit.Result.Actual is not null) { <div class="small muted pre">Actual: @hit.Result.Actual</div> }
                                </li>
                            }
                        </ul>
                    </dd>
                </dl>
            </article>
        }
    }

    @if (_showClean)
    {
        <h2 class="rec-server">No problem <span class="muted">(@clean.Count)</span></h2>
        <section class="card table-scroll">
            <table class="results">
                <thead><tr><th>Server</th><th>No.</th><th>Check</th><th>Member</th><th class="num" title="Latest runs where it passed">Passed in</th></tr></thead>
                <tbody>
                    @foreach (var c in clean)
                    {
                        <tr><td>@c.Codebase.ServerType()</td><td class="mono num">@TestNumbers.Of(c.Id)</td><td class="mono">@c.Id</td><td class="mono">@c.Member</td><td class="num">@c.Runs</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private static readonly Outcome[] Problems = [Outcome.Fail, Outcome.Error, Outcome.Warning];

    private RecommendationSet? _set;
    private readonly HashSet<Outcome> _outcomes = [];
    private string _codebase = "";
    private string _search = "";
    private bool _showClean;
    private string? _lastRun;

    // Every saved run; the recommendations are built from the top tab's own runs (ConformU, or ASCOM Conformance Check).
    private List<RunReport>? _all;

    // Which test's runs: set by the address (conformu/recommendations or recommendations), never by the tab remembered
    // in memory, so a reload or a link opened on its own shows the right ones.
    private bool ConformUOnly => RunPageState.IsConformUPage(Nav.ToBaseRelativePath(Nav.Uri));
    private string? _builtKey;
    private RunGroup? _group;

    protected override async Task OnInitializedAsync()
    {
        _lastRun = Runs.LastReport?.Id;
        _all = await Store.ListAsync();
        Runs.Changed += OnRunsChanged;
        State.Changed += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet() => BuildForAddress();

    /// <summary>
    /// Going from one test's Recommendations to the other's keeps this page (the same component at another address,
    /// with no parameters, so Blazor doesn't set them again): follow the address here, or it stays the other test's.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        // Only to this page's own addresses: leaving it (to a report, say) must not set the tab.
        if (Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].ToLowerInvariant() is not ("recommendations" or "conformu/recommendations")) return;
        BuildForAddress();
        StateHasChanged();
    });

    /// <summary>Builds from the address's test's runs, and moves the top tab to that test.</summary>
    private void BuildForAddress()
    {
        var conformU = ConformUOnly;
        State.Tab = conformU ? RunPageTab.ConformU : RunPageTab.Conformance;
        if (_all is null) return;
        // The default view, or the run group picked on the Reports tab: rebuilt when either changes.
        var key = $"{conformU}|{State.GroupId}";
        if (_builtKey == key) return;
        _builtKey = key;
        Rebuild(conformU);
    }

    /// <summary>The recommendations of the run group picked on the Reports tab, or of the newest run of each device.</summary>
    private void Rebuild(bool conformU)
    {
        var runs = RunPageState.Shown(_all!, conformU);
        _group = RunGroups.Find(RunGroups.Build(runs), State.GroupId);
        _set = _group is null ? RecommendationBuilder.Build(runs) : RecommendationBuilder.BuildFrom([_group.Latest], runs);
    }

    private void OnStateChanged() => InvokeAsync(() =>
    {
        BuildForAddress();
        StateHasChanged();
    });

    /// <summary>The recommendations the server and search filters leave (not yet filtered by outcome).</summary>
    private List<Recommendation> Filtered => [.. _set!.Recommendations.Where(r =>
        (_codebase.Length == 0 || r.Codebase.ToString() == _codebase)
        && (Matches(r.Id, r.Member) || r.Fixes.Any(f => f.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || r.Sources.Any(s => s.Contains(_search, StringComparison.OrdinalIgnoreCase))))];

    private bool Matches(string id, string member)
        => _search.Length == 0 || id.Contains(_search, StringComparison.OrdinalIgnoreCase) || member.Contains(_search, StringComparison.OrdinalIgnoreCase)
           || TestNumbers.Of(id).ToString() == _search.Trim();

    private void Toggle(Outcome o)
    {
        if (!_outcomes.Remove(o)) _outcomes.Add(o);
    }

    /// <summary>A run finished: rebuild from the saved runs.</summary>
    private void OnRunsChanged() => InvokeAsync(async () =>
    {
        if (Runs.IsRunning || Runs.LastReport?.Id == _lastRun) return;
        _lastRun = Runs.LastReport?.Id;
        _all = await Store.ListAsync();
        Rebuild(ConformUOnly);
        StateHasChanged();
    });

    public void Dispose()
    {
        Runs.Changed -= OnRunsChanged;
        State.Changed -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
