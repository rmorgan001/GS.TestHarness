{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5207",

  // Where saved runs go (empty: Documents\GS.TestHarness\Reports).
  "ReportsFolder": "",

  // The source of each server under test is set in the app (Source Code local Path or GitHub full URL to the code).
  // Root may give a whole path as a default; empty, a server has no code review until its source is set.
  "Codebases": {
    "GSServer": {
      "Root": "",
      "TelescopeFiles": [ "GS.Ascom.SkyTelescope/Telescope.cs" ]
    },
    "GreenSwampAlpaca": {
      "Root": "",
      "TelescopeFiles": [ "GreenSwamp.Alpaca.Server/TelescopeDriver/Telescope.cs" ]
    }
  }
}
