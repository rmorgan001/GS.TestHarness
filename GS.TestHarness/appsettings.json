{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5207",

  // Where saved runs go (empty: Documents\GS.TestHarness\Reports).
  "ReportsFolder": "",

  // The source of each server under test. Root is absolute, or a folder name looked for beside this app's
  // folders (so repositories side by side in source\repos are found).
  "Codebases": {
    "GSServer": {
      "Root": "GSServer",
      "TelescopeFiles": [ "GS.Ascom.SkyTelescope/Telescope.cs" ]
    },
    "GreenSwampAlpaca": {
      "Root": "GreenSwampAlpaca",
      "TelescopeFiles": [ "GreenSwamp.Alpaca.Server/TelescopeDriver/Telescope.cs" ]
    }
  }
}
